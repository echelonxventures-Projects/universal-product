          "SRC-REVIEW-2026-09-17",
          "SRC-REVIEW-2026-10-12",
          "SRC-SUPERSEDED-ADDENDUM",
          "SRC-SUPERSEDED-MASTER-ARCH",
          "SRC-SUPERSEDED-ZERO-HARDCODING",
          "SRC-UCOS-ADDENDUM",
          "SRC-UCOS-CAPABILITY-OS",
          "SRC-UCOS-MASTER-ARCH",
          "SRC-UCOS-OMEGA",
          "SRC-UCRS-ZERO-HARDCODING"
        ]
      },
      "prerequisites": [
        "CTX-BOOTSTRAP"
      ],
      "previous": "CTX-CONTINUITY-SYSTEM",
      "next": "CTX-PLATFORM-QUALITY",
      "related": [
        "CTX-CONTINUITY-SYSTEM"
      ],
      "verification": [
        "npm run context:verify",
        "npm run context:restore-check",
        "npm run context:coverage"
      ],
      "lifecycle": "canonical-active"
    },
    {
      "id": "CTX-GOVERNANCE",
      "title": "Constitutional governance and the registry pipeline",
      "use": "Load before touching _registry/, constitutional documents, the canonical compile, or anything claiming a single source of truth.",
      "scope": [
        "the laws and their owners",
        "registry-as-truth and the sealed compile",
        "registry tooling and its known defect"
      ],
      "exclusions": [
        "the content of the 93 artifacts (read them at their owner)",
        "continuity-system internals"
      ],
      "include": {
        "constraints": [
          "CST-FROZEN-PRIMITIVES",
          "CST-SEAL-DERIVED",
          "CST-SUPERSEDED-NOT-AUTHORITY"
        ],
        "decisions": [
          "DEC-REGISTRY-AS-SOT",
          "DEC-SEALED-CANONICAL-COMPILE"
        ],
        "artifacts": [
          "ART-REGISTRY-AUDIT",
          "ART-REGISTRY-PROJECT",
          "ART-REGISTRY-COMPILE",
          "ART-REGISTRY-GATE",
          "ART-CANONICAL"
        ],
        "issues": [
          "ISS-CANONICAL-INPUT-MISNAMED",
          "ISS-CONTENT-MAP-SHARED-KEYS"
        ],
        "sources": [
          "SRC-REPOSITORY-INDEX",
          "SRC-UCRS-ZERO-HARDCODING",
          "SRC-SUPERSEDED-ZERO-HARDCODING"
        ]
      },
      "prerequisites": [
        "CTX-BOOTSTRAP"
      ],
      "previous": "CTX-BOOTSTRAP",
      "next": "CTX-CONTINUITY-DESIGN",
      "verification": [
        "node _registry/audit.js",
        "npm run registry"
      ],
      "lifecycle": "canonical-active"
    },
    {
      "id": "CTX-PLATFORM-QUALITY",
      "title": "Platform quality — open review findings and runtime risks",
      "use": "Load before security or data-layer work on the platform runtime.",
      "scope": [
        "unreconciled review findings",
        "Postgres cutover status",
        "test-suite duration risk",
        "dependency-claim conflict"
      ],
      "exclusions": [
        "the fixes themselves"
      ],
      "include": {
        "constraints": [
          "CST-NODE-ENGINE",
          "CST-CONFIG-OVER-CODE",
          "CST-DEPENDENCY-MINIMAL"
        ],
        "issues": [
          "ISS-REVIEW-FINDINGS-UNRECONCILED",
          "ISS-PG-CUTOVER-STATUS",
          "ISS-NPM-TEST-DURATION",
          "ISS-RUNTIME-DEPENDENCY-CLAIM"
        ],
        "sources": [
          "SRC-REVIEW-2026-10-12",
          "SRC-REVIEW-2026-09-17"
        ]
      },
      "prerequisites": [
        "CTX-BOOTSTRAP"
      ],
      "previous": "CTX-EVIDENCE-ARCHIVE",
      "verification": [
        "npm test"
      ],
      "lifecycle": "canonical-active"
    }
  ]
}
