{
  "$comment": "Context pack specifications. A pack's content is derived from these specs + the knowledge; the generated files in PROJECT-CONTEXT/contexts/ are never edited. previous/next are a navigation chain; prerequisites are the dependency truth.",
  "registryId": "CTX-REG-CONTEXTS",
  "kind": "context",
  "version": 1,
  "records": [
    {
      "id": "CTX-BOOTSTRAP",
      "title": "Bootstrap — mandatory rules and current state",
      "use": "Read first, in every session, before any task-specific pack. Small by design.",
      "scope": [
        "global critical constraints",
        "the current-state snapshot",
        "open approvals and recovery limits every agent must know"
      ],
      "exclusions": [
        "task-specific requirements and decisions (see the task's packs)",
        "product runtime details"
      ],
      "bootstrap": true,
      "include": {
        "issues": [
          "ISS-CTX-DECISIONS-UNAPPROVED",
          "ISS-PRIOR-CONVERSATIONS-INACCESSIBLE"
        ],
        "artifacts": [
          "ART-AGENTS-MD"
        ]
      },
      "next": "CTX-GOVERNANCE",
      "verification": [
        "npm run context:verify",
        "git status"
      ],
      "budgetBytes": 12000,
      "lifecycle": "canonical-active"
    },
    {
      "id": "CTX-CONTINUITY-DESIGN",
      "title": "Context continuity — design decisions and open design questions",
      "use": "Load before changing how the continuity system works; read before CTX-CONTINUITY-SYSTEM.",
      "scope": [
        "DEC-CTX-* (proposed, awaiting owner approval) with rationale and rejected options",
        "open design gaps"
      ],
      "exclusions": [
        "requirements and code artifacts (CTX-CONTINUITY-SYSTEM)",
        "evidence inventory (CTX-EVIDENCE-ARCHIVE)"
      ],
      "include": {
        "decisions": [
          "DEC-CTX-BYTE-BUDGETS",
          "DEC-CTX-DERIVED-EDGES",
          "DEC-CTX-DETERMINISTIC-TIME",
          "DEC-CTX-GIT-AS-ARCHIVE",
          "DEC-CTX-LOCATION",
          "DEC-CTX-MEMORY-LEDGER-HISTORICAL",
          "DEC-CTX-ZERO-DEPENDENCIES"
        ],
        "issues": [
          "ISS-MASTER-PROMPT-NOT-ARCHIVED"
        ]
      },
      "prerequisites": [
        "CTX-BOOTSTRAP",
        "CTX-GOVERNANCE"
      ],
      "previous": "CTX-GOVERNANCE",
      "next": "CTX-CONTINUITY-SYSTEM",
      "verification": [
        "npm run context:verify"
      ],
      "lifecycle": "canonical-active"
    },
    {
      "id": "CTX-CONTINUITY-SYSTEM",
      "title": "Context continuity — requirements and code",
      "use": "Load to change, extend or debug PROJECT-CONTEXT, lib/context, scripts/context.js or the agent protocol.",
      "scope": [
        "REQ-CTX-* and their acceptance criteria",
        "the code, schema and test artifacts"
      ],
      "exclusions": [
        "design rationale (CTX-CONTINUITY-DESIGN, a prerequisite)",
        "evidence inventory (CTX-EVIDENCE-ARCHIVE)",
        "product runtime"
      ],
      "include": {
        "requirements": [
          "REQ-CTX-ARCHIVE",
          "REQ-CTX-ASSIMILATION",
          "REQ-CTX-CI",
          "REQ-CTX-COVERAGE",
          "REQ-CTX-ENTRY-POINTS",
          "REQ-CTX-GRAPH",
          "REQ-CTX-HANDOFF",
          "REQ-CTX-HYGIENE",
          "REQ-CTX-INVALIDATION",
          "REQ-CTX-KNOWLEDGE-MODEL",
          "REQ-CTX-NO-COMPETING-SOT",
          "REQ-CTX-PACKS",
          "REQ-CTX-SECURITY",
          "REQ-CTX-VERIFICATION"
        ],
        "artifacts": [
          "ART-CTX-UTIL",
          "ART-CTX-SCHEMA-VALIDATOR",
          "ART-CTX-STORE",
          "ART-CTX-GRAPH",
          "ART-CTX-PACKS",
          "ART-CTX-ARCHIVE",
          "ART-CTX-COVERAGE",
          "ART-CTX-HYGIENE",
          "ART-CTX-VIEWS",
          "ART-CTX-PROTOCOL",
          "ART-CTX-INDEX",
          "ART-CTX-CLI",
          "ART-CTX-SCHEMA-KNOWLEDGE",
          "ART-CTX-SCHEMA-HANDOFF",
          "ART-CTX-SCHEMA-RECEIPT",
          "ART-CTX-REG-LIFECYCLE",
          "ART-CTX-REG-RELATIONS",
          "ART-CTX-CONFIG",
          "ART-TEST-CONTEXT",
          "ART-CLAUDE-MD"
        ]
      },
      "prerequisites": [
        "CTX-CONTINUITY-DESIGN"
      ],
      "previous": "CTX-CONTINUITY-DESIGN",
      "next": "CTX-EVIDENCE-ARCHIVE",
      "verification": [
        "npm run context:verify",
        "node test/context.js"
      ],
      "lifecycle": "canonical-active"
    },
    {
      "id": "CTX-EVIDENCE-ARCHIVE",
      "title": "Source evidence — inventory, gaps and coverage",
      "use": "Load when citing evidence, importing or capturing sources, or judging what history is and is not preserved.",
      "scope": [
        "every archived source and its preservation status",
        "known gaps",
        "archive and coverage design"
      ],
      "exclusions": [
        "the content of the sources (restore or read them at their locator)"
      ],
      "include": {
        "requirements": [
          "REQ-CTX-ARCHIVE",
          "REQ-CTX-COVERAGE"
        ],
        "decisions": [
          "DEC-CTX-GIT-AS-ARCHIVE",
          "DEC-CTX-MEMORY-LEDGER-HISTORICAL"
        ],
        "issues": [
          "ISS-PRIOR-CONVERSATIONS-INACCESSIBLE",
          "ISS-MASTER-PROMPT-NOT-ARCHIVED",
          "ISS-SEGMENTS-UNPROCESSED"
        ],
        "artifacts": [
          "ART-GIT-OBJECT-STORE",
          "ART-ARCHIVE-STORE",
          "ART-MEMORY-LEDGER"
        ],
        "tags": [
          "archive"
        ],
        "sources": [
          "SRC-ARCH-1",
          "SRC-ARCH-2",
          "SRC-ARCH-3",
          "SRC-ARCH-4",
          "SRC-ARCH-5",
          "SRC-ARCH-6",
          "SRC-CONV-2026-10-22-MASTER-PROMPT",
          "SRC-CONV-PRIOR-SESSIONS",
