{
  "$comment": "Lifecycle registry for every continuity record (requirements, decisions, constraints, artifacts, issues, sources, contexts). Extensible: add a state or transition here, never in code.",
  "registryId": "CTX-REG-LIFECYCLE",
  "version": 1,
  "states": {
    "proposed":                { "active": true,  "authority": "provisional", "meaning": "Recorded but not yet approved by the owner. May guide work; must be surfaced as unapproved." },
    "canonical-active":        { "active": true,  "authority": "canonical",   "meaning": "The single authoritative statement of this knowledge." },
    "operational-active":      { "active": true,  "authority": "operational", "meaning": "In current use for operations (tooling, runbooks) but not the owner of a concept." },
    "derived":                 { "active": true,  "authority": "derived",     "meaning": "Deterministically generated from canonical sources; regenerable, never edited by hand." },
    "consolidation-candidate": { "active": true,  "authority": "canonical",   "meaning": "Flagged for consolidation; remains authoritative until the consolidation is approved and applied." },
    "quarantined":             { "active": false, "authority": "none",        "meaning": "Unresolved or suspect; must not govern work until reviewed." },
    "superseded":              { "active": false, "authority": "none",        "meaning": "Replaced by the record named in supersededBy. Kept for recovery; never governs active work." },
    "historical-evidence":     { "active": false, "authority": "evidence",    "meaning": "Preserved original evidence. Searchable and citable as provenance, never current authority." },
    "retired":                 { "active": false, "authority": "none",        "meaning": "No longer relevant. Preserved in history (git), excluded from active context." }
  },
  "transitions": [
    { "from": "proposed",                "to": "canonical-active" },
    { "from": "proposed",                "to": "operational-active" },
    { "from": "proposed",                "to": "quarantined" },
    { "from": "proposed",                "to": "retired",             "requiresApproval": true },
    { "from": "canonical-active",        "to": "consolidation-candidate" },
    { "from": "canonical-active",        "to": "quarantined" },
    { "from": "canonical-active",        "to": "superseded",          "requiresApproval": true, "requires": ["supersededBy"] },
    { "from": "canonical-active",        "to": "historical-evidence", "requiresApproval": true },
    { "from": "operational-active",      "to": "consolidation-candidate" },
    { "from": "operational-active",      "to": "quarantined" },
    { "from": "operational-active",      "to": "superseded",          "requiresApproval": true, "requires": ["supersededBy"] },
    { "from": "operational-active",      "to": "historical-evidence" },
    { "from": "operational-active",      "to": "retired",             "requiresApproval": true },
    { "from": "derived",                 "to": "superseded",          "requires": ["supersededBy"] },
    { "from": "derived",                 "to": "retired" },
    { "from": "consolidation-candidate", "to": "canonical-active" },
    { "from": "consolidation-candidate", "to": "operational-active" },
    { "from": "consolidation-candidate", "to": "quarantined" },
    { "from": "consolidation-candidate", "to": "superseded",          "requiresApproval": true, "requires": ["supersededBy"] },
    { "from": "quarantined",             "to": "canonical-active",    "requiresApproval": true },
    { "from": "quarantined",             "to": "operational-active",  "requiresApproval": true },
    { "from": "quarantined",             "to": "consolidation-candidate" },
    { "from": "quarantined",             "to": "retired",             "requiresApproval": true },
    { "from": "superseded",              "to": "historical-evidence" },
    { "from": "superseded",              "to": "canonical-active",    "requiresApproval": true },
    { "from": "retired",                 "to": "historical-evidence" }
  ]
}
