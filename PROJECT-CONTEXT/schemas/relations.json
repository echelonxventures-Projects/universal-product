{
  "$comment": "Typed relationship registry. Direction is always from -> to and reads as a sentence: '<from> <rel> <to>'. 'fields' says which record fields emit the edge (reverse: true means the field lives on the 'to' record). acyclic: true means a cycle is an error; there is no silent exception.",
  "registryId": "CTX-REG-RELATIONS",
  "version": 1,
  "relations": {
    "derived-from": { "semantics": "<from> was derived from evidence or knowledge in <to>.", "from": ["requirement", "decision", "constraint", "issue", "task", "artifact", "context"], "to": ["source", "artifact", "requirement", "decision", "constraint"], "acyclic": true,
                      "fields": [{ "kind": "*", "field": "sources" }, { "kind": "artifact", "field": "derivedFrom" }] },
    "supports":     { "semantics": "<from> is evidence in favour of <to> without being its origin.", "from": ["source", "artifact", "decision"], "to": ["requirement", "decision", "constraint"], "acyclic": false,
                      "fields": [{ "kind": "*", "field": "supports" }] },
    "constrains":   { "semantics": "<from> limits what <to> may do.", "from": ["constraint", "decision"], "to": ["requirement", "constraint", "task", "artifact", "context"], "acyclic": false,
                      "fields": [{ "kind": "decision", "field": "affects" }, { "kind": "task", "field": "constraints", "reverse": true }, { "kind": "task", "field": "decisions", "reverse": true }] },
    "depends-on":   { "semantics": "<from> cannot be correct or complete without <to>.", "from": ["requirement", "decision", "artifact", "task", "context"], "to": ["requirement", "decision", "artifact", "task", "context", "constraint"], "acyclic": true,
                      "fields": [{ "kind": "*", "field": "dependsOn" }, { "kind": "context", "field": "prerequisites" }] },
    "implements":   { "semantics": "<from> realises <to>.", "from": ["artifact", "task"], "to": ["requirement", "decision"], "acyclic": true,
                      "fields": [{ "kind": "requirement", "field": "implementedBy", "reverse": true }, { "kind": "task", "field": "requirements" }] },
    "verifies":     { "semantics": "<from> is executable evidence that <to> holds.", "from": ["artifact"], "to": ["requirement", "constraint", "decision"], "acyclic": true,
                      "fields": [{ "kind": "requirement", "field": "verifiedBy", "reverse": true }, { "kind": "constraint", "field": "verifiedBy", "reverse": true }] },
    "supersedes":   { "semantics": "<from> replaces <to>; <to> must not govern active work.", "from": ["requirement", "decision", "constraint", "artifact", "source", "context"], "to": ["requirement", "decision", "constraint", "artifact", "source", "context"], "acyclic": true,
                      "fields": [{ "kind": "*", "field": "supersededBy", "reverse": true }] },
    "conflicts-with": { "semantics": "<from> and <to> cannot both hold as stated. Symmetric; recorded once.", "from": ["requirement", "decision", "constraint", "source"], "to": ["requirement", "decision", "constraint", "source"], "acyclic": false,
                      "fields": [{ "kind": "*", "field": "conflictsWith" }] },
    "belongs-to":   { "semantics": "<from> is a part of <to> (an attachment of a source, a subpack of a pack).", "from": ["source", "context"], "to": ["source", "context"], "acyclic": true,
                      "fields": [{ "kind": "source", "field": "attachmentOf" }] },
    "included-in":  { "semantics": "<from> is part of the curated content of context pack <to>.", "from": ["requirement", "decision", "constraint", "artifact", "issue", "source"], "to": ["context"], "acyclic": true,
                      "fields": [{ "kind": "context", "field": "include.requirements", "reverse": true }, { "kind": "context", "field": "include.decisions", "reverse": true }, { "kind": "context", "field": "include.constraints", "reverse": true }, { "kind": "context", "field": "include.artifacts", "reverse": true }, { "kind": "context", "field": "include.issues", "reverse": true }, { "kind": "context", "field": "include.sources", "reverse": true }] },
    "references":   { "semantics": "<from> mentions <to> for navigation; no dependency implied.", "from": ["*"], "to": ["*"], "acyclic": false,
                      "fields": [{ "kind": "context", "field": "related" }, { "kind": "issue", "field": "affects" }, { "kind": "task", "field": "contexts" }] },
    "blocks":       { "semantics": "<from> must be resolved before <to> can proceed.", "from": ["issue", "task", "decision"], "to": ["task", "requirement", "decision", "context"], "acyclic": true,
                      "fields": [{ "kind": "issue", "field": "blocks" }] },
    "resolves":     { "semantics": "<from> closes the open question or conflict <to>.", "from": ["decision", "task", "artifact"], "to": ["issue"], "acyclic": true,
                      "fields": [{ "kind": "issue", "field": "resolvedBy", "reverse": true }] },
    "captured-by":  { "semantics": "<from> (original evidence) is preserved by archive store <to>.", "from": ["source"], "to": ["artifact"], "acyclic": true,
                      "fields": [{ "kind": "source", "field": "capturedBy" }] }
  }
}
