{
  "$schema": "https://ucos.io/registry/api.v1.json",
  "registryId": "UCOS-REG-API",
  "canonicalName": "Live API Ownership Registry",
  "version": "Omega-1",
  "status": "Living",
  "ownerDomain": "Integration",
  "law": "LAW-002 Knowledge Once — every route the platform serves (lib/api.js → routes, the one route table) has exactly one owning domain, given by the first rule its path matches. The register is derived from the live table at compile time; it is never a second copy.",
  "source": "lib/api.js",
  "table": "routes",
  "owners": [
    {"pattern": "^/api/(ucos|ucii/(knowledge|domains))(/|$)", "owner": "Registry"},
    {"pattern": "^/api/ucii/(capabilities|usage)(/|$)", "owner": "Offering"},
    {"pattern": "^/api/ucii/policies(/|$)", "owner": "Policy"},
    {"pattern": "^/api/ucii/workflows(/|$)", "owner": "Runtime"},
    {"pattern": "^/api/ucii/config(/|$)", "owner": "Operations"},
    {"pattern": "^/api/(meta|registries)(/|$)", "owner": "Registry"},
    {"pattern": "^/api/platform/(registries|data|attributes|entity-attributes|entity-types|tenant-entities|tenant-fields|universe-fields)(/|$)", "owner": "Registry"},
    {"pattern": "^/api/admin/(entity-meta|entity-usage|attributes)(/|$)", "owner": "Registry"},
    {"pattern": "^/api/platform/global/(countries|country)(/|$)", "owner": "Geo"},
    {"pattern": "^/api/platform/global/tenant/country$", "owner": "Geo"},
    {"pattern": "^/api/platform/global/(currencies|currency)(/|$)", "owner": "Value"},
    {"pattern": "^/api/platform/global/tenant/currency$", "owner": "Value"},
    {"pattern": "^/api/platform/global/(providers|provider)(/|$)", "owner": "Integration"},
    {"pattern": "^/api/platform/global/tenant/(providers|provider)$", "owner": "Integration"},
    {"pattern": "^/api/platform/global/(plans|plan)(/|$)", "owner": "Offering"},
    {"pattern": "^/api/platform/global/tenant/plan$", "owner": "Offering"},
    {"pattern": "^/api/platform/global/tenant$", "owner": "Party"},
    {"pattern": "^/api/(fx|platform/fx)(/|$)", "owner": "Value"},
    {"pattern": "^/api/(auth|session|scim)(/|$)", "owner": "Security"},
    {"pattern": "^/api/platform/(login|logout|me|keys|security|identity-templates)(/|$)", "owner": "Security"},
    {"pattern": "^/api/admin/(sso|scim|identity-providers|identity-provider-types|identity-settings|risk)(/|$)", "owner": "Security"},
    {"pattern": "^/api/(admin|platform)/roles(/|$)", "owner": "Authority"},
    {"pattern": "^/api/(consent|privacy)(/|$)", "owner": "Compliance"},
    {"pattern": "^/api/admin/(privacy|compliance|retention)(/|$)", "owner": "Compliance"},
    {"pattern": "^/api/(admin|platform)/(audit|chain)(/|$)", "owner": "Audit"},
    {"pattern": "^/api/admin/trash(/|$)", "owner": "Evolution"},
    {"pattern": "^/api/(rules|admin/rules|platform/rules|admin/tax)(/|$)", "owner": "Rule"},
    {"pattern": "^/api/platform/policies(/|$)", "owner": "Policy"},
    {"pattern": "^/api/(user|addresses|tenancy|tenant)(/|$)", "owner": "Party"},
    {"pattern": "^/api/admin/(account|users|staff|mode)(/|$)", "owner": "Party"},
    {"pattern": "^/api/platform/(users|admins|tenants)(/|$)", "owner": "Party"},
    {"pattern": "^/api/(platform/kinds|compose)(/|$)", "owner": "Package"},
    {"pattern": "^/api/(capabilities|modules|platform/modules|billing)(/|$)", "owner": "Offering"},
    {"pattern": "^/api/(admin|platform)/billing(/|$)", "owner": "Offering"},
    {"pattern": "^/api/platform/(plans|invoices|revenue|usage)(/|$)", "owner": "Offering"},
    {"pattern": "^/api/(taxonomy|admin/taxonomy|admin/departments|admin/segments)(/|$)", "owner": "Semantic"},
    {"pattern": "^/api/admin/relationships(/|$)", "owner": "Relationship"},
    {"pattern": "^/api/(themes|branding|sitemap|sitemap\\.xml|seo|config|hint)(/|$)", "owner": "Experience"},
    {"pattern": "^/api/platform/(branding|branding-permissions|hint)(/|$)", "owner": "Experience"},
    {"pattern": "^/api/admin/(banners|cards)(/|$)", "owner": "Experience"},
    {"pattern": "^/api/(search|suggest|facets|reco|recommend)(/|$)", "owner": "Search"},
    {"pattern": "^/api/(helpdesk|support)(/|$)", "owner": "Communication"},
    {"pattern": "^/api/admin/helpdesk(/|$)", "owner": "Communication"},
    {"pattern": "^/api/notifications(/|$)", "owner": "Notification"},
    {"pattern": "^/api/(ai|platform/ai)(/|$)", "owner": "Agent"},
    {"pattern": "^/api/admin/ai-gateways(/|$)", "owner": "Agent"},
    {"pattern": "^/api/(webhooks|providers)(/|$)", "owner": "Integration"},
    {"pattern": "^/api/admin/(webhooks|gateway|gateways|custom-providers|export)(/|$)", "owner": "Integration"},
    {"pattern": "^/api/platform/(custom-providers|fanout)(/|$)", "owner": "Integration"},
    {"pattern": "^/api/(dashboards|reports|experiments)(/|$)", "owner": "Insight"},
