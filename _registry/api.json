    {"pattern": "^/api/admin/(monitor|sla)(/|$)", "owner": "Operations"},
    {"pattern": "^/api/platform/db(/|$)", "owner": "Persistence"},
    {"pattern": "^/api/admin/settings(/|$)", "owner": "Context"},
    {"pattern": "^/api/(products|cart|checkout|orders|returns|saved|viewed|compare|coupon|giftcard|promos|offers|reviews|qna|subscriptions|membership|wallet|market|marketplace|affiliate|stores|rfqs|shipments|carriers|zip|feeds|goip|qc|fintech|trade|shipping|marketing)(/|$)", "owner": "Commerce"},
    {"pattern": "^/api/admin/(products|skus|inventory|warehouses|orders|returns|promotions|reviews|qna|rfqs|tenders|contracts|sellers|settlements|payments|fin|transfers|shipments|serialized|memberships|recurring|mobility|operations|ops|marketplace|ugc)(/|$)", "owner": "Commerce"},
    {"pattern": "^/api/platform/(global-products|global-catalog|offers|store-product-config|shipping)(/|$)", "owner": "Commerce"}
  ]
}
