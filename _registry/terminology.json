{
  "$schema": "https://ucos.io/registry/terminology.v1.json",
  "registryId": "UCOS-REG-TERMS",
  "canonicalName": "Canonical Terminology Registry",
  "version": "Omega-1",
  "status": "Constitutional Freeze",
  "ownerDomain": "Semantic Domain",
  "law": "No semantic term may exist with multiple meanings. No meaning may exist with multiple canonical definitions.",
  "conflictResolution": "On any collision, the Semantic Domain registry is authoritative. All other usages are void.",
  "terms": [
    {"termId": "T-EXISTENCE", "canonicalName": "Existence", "definition": "Anything that may exist.", "aliases": ["thing", "object", "item"], "prohibitedMeanings": ["business meaning", "commercial meaning", "operational meaning"], "nonExamples": ["Product", "Service"]},
    {"termId": "T-ENTITY", "canonicalName": "Entity", "definition": "Technical representation of an Existence Object.", "aliases": ["record", "row"], "prohibitedMeanings": ["existence itself"], "nonExamples": ["the actual product"]},
    {"termId": "T-KNOWLEDGE", "canonicalName": "Knowledge", "definition": "Interpreted information with evidence and meaning.", "aliases": ["validated understanding"], "prohibitedMeanings": ["data", "information", "evidence"], "nonExamples": ["a price feed", "a timestamp"]},
    {"termId": "T-DATA", "canonicalName": "Data", "definition": "Raw observations.", "aliases": ["readings"], "prohibitedMeanings": ["knowledge", "meaning"], "examples": ["price", "timestamp", "sensor reading"]},
    {"termId": "T-INFORMATION", "canonicalName": "Information", "definition": "Organized data.", "aliases": [], "prohibitedMeanings": ["knowledge"], "nonExamples": ["a validated assertion"]},
    {"termId": "T-EVIDENCE", "canonicalName": "Evidence", "definition": "Proof supporting an assertion.", "aliases": ["proof"], "prohibitedMeanings": ["knowledge", "trust"], "nonExamples": ["a computed trust score"]},
    {"termId": "T-TRUST", "canonicalName": "Trust", "definition": "Computed confidence in an assertion, derived from evidence.", "aliases": ["confidence"], "prohibitedMeanings": ["evidence", "faith"], "nonExamples": ["a raw document"]},
    {"termId": "T-MEANING", "canonicalName": "Meaning", "definition": "Semantic interpretation; higher-level understanding.", "aliases": ["semantics"], "prohibitedMeanings": ["classification", "taxonomy", "ontology"], "nonExamples": ["a category assignment"]},
    {"termId": "T-ONTOLOGY", "canonicalName": "Ontology", "definition": "What exists.", "aliases": [], "prohibitedMeanings": ["taxonomy", "classification"], "nonExamples": ["a product category tree"]},
    {"termId": "T-TAXONOMY", "canonicalName": "Taxonomy", "definition": "How things are classified.", "aliases": [], "prohibitedMeanings": ["ontology", "meaning"], "nonExamples": ["what exists"]},
    {"termId": "T-CLASSIFICATION", "canonicalName": "Classification", "definition": "Assignment into taxonomy.", "aliases": [], "prohibitedMeanings": ["meaning"], "nonExamples": ["semantic interpretation"]},
    {"termId": "T-RELATIONSHIP", "canonicalName": "Relationship", "definition": "Connection between objects.", "aliases": ["link", "edge"], "prohibitedMeanings": ["causality"], "nonExamples": ["why A affects B"]},
    {"termId": "T-CAUSALITY", "canonicalName": "Causality", "definition": "Reason one object influences another.", "aliases": [], "prohibitedMeanings": ["relationship"], "nonExamples": ["a mere link"]},
    {"termId": "T-OBSERVATION", "canonicalName": "Observation", "definition": "Captured reality.", "aliases": ["capture"], "prohibitedMeanings": ["inference"], "nonExamples": ["a derived pattern"]},
    {"termId": "T-INFERENCE", "canonicalName": "Inference", "definition": "Derived reality.", "aliases": ["discovery"], "prohibitedMeanings": ["observation"], "nonExamples": ["a raw sensor reading"]},
    {"termId": "T-SIMULATION", "canonicalName": "Simulation", "definition": "Possible reality.", "aliases": ["scenario"], "prohibitedMeanings": ["reality"], "nonExamples": ["an actual transaction"]},
    {"termId": "T-PERSPECTIVE", "canonicalName": "Perspective", "definition": "Observer-specific interpretation.", "aliases": ["viewpoint"], "prohibitedMeanings": ["context"], "nonExamples": ["a jurisdiction boundary"]},
    {"termId": "T-CONTEXT", "canonicalName": "Context", "definition": "Applicability boundary.", "aliases": ["scope"], "prohibitedMeanings": ["perspective"], "nonExamples": ["an observer's opinion"]},
    {"termId": "T-AUTHORITY", "canonicalName": "Authority", "definition": "Who has the right to govern.", "aliases": ["jurisdiction"], "prohibitedMeanings": ["ownership"], "nonExamples": ["who is responsible"]},
    {"termId": "T-OWNERSHIP", "canonicalName": "Ownership", "definition": "Who possesses responsibility.", "aliases": [], "prohibitedMeanings": ["authority"], "nonExamples": ["the right to govern"]},
    {"termId": "T-POLICY", "canonicalName": "Policy", "definition": "Behavioral governance.", "aliases": [], "prohibitedMeanings": ["rule"], "nonExamples": ["an executable constraint"]},
    {"termId": "T-RULE", "canonicalName": "Rule", "definition": "Executable constraint.", "aliases": [], "prohibitedMeanings": ["policy", "decision"], "nonExamples": ["a governance statement"]},
    {"termId": "T-DECISION", "canonicalName": "Decision", "definition": "Outcome of evaluation.", "aliases": ["outcome"], "prohibitedMeanings": ["rule"], "nonExamples": ["an executable constraint"]},
    {"termId": "T-EVENT", "canonicalName": "Event", "definition": "Something that occurred.", "aliases": ["occurrence"], "prohibitedMeanings": ["state"], "nonExamples": ["current condition"]},
    {"termId": "T-STATE", "canonicalName": "State", "definition": "Current condition.", "aliases": ["condition"], "prohibitedMeanings": ["event"], "nonExamples": ["something that occurred"]},
    {"termId": "T-CAPABILITY", "canonicalName": "Capability", "definition": "What may be performed.", "aliases": [], "prohibitedMeanings": ["process"], "nonExamples": ["a sequence of execution"]},
    {"termId": "T-PROCESS", "canonicalName": "Process", "definition": "Sequence of execution.", "aliases": [], "prohibitedMeanings": ["capability", "workflow"], "nonExamples": ["what may be performed"]},
    {"termId": "T-WORKFLOW", "canonicalName": "Workflow", "definition": "Orchestrated process.", "aliases": [], "prohibitedMeanings": ["process"], "nonExamples": ["an unorchestrated sequence"]},
    {"termId": "T-TWIN", "canonicalName": "Digital Twin", "definition": "Digital representation of reality.", "aliases": ["twin"], "prohibitedMeanings": ["reality"], "nonExamples": ["the physical asset"]},
    {"termId": "T-AGENT", "canonicalName": "Agent", "definition": "Autonomous actor operating under governance.", "aliases": [], "prohibitedMeanings": ["user", "service", "process"], "nonExamples": ["a human", "a microservice"]},
    {"termId": "T-PROJECTION", "canonicalName": "Projection", "definition": "Runtime representation derived from primitives; never owns truth.", "aliases": ["derived view"], "prohibitedMeanings": ["primitive", "source of truth"], "examples": ["Product", "Service", "Offer", "Contract"], "nonExamples": ["a registry entry"]},
    {"termId": "T-CONSTITUTION", "canonicalName": "Constitution", "definition": "The binding law every domain obeys.", "aliases": ["charter"], "prohibitedMeanings": ["policy"]},
    {"termId": "T-AMENDMENT", "canonicalName": "Amendment", "definition": "A governed, recorded change to the constitution or its registries.", "aliases": ["constitutional change"], "prohibitedMeanings": ["edit"]},
    {"termId": "T-GUIDE", "canonicalName": "Guide", "definition": "Instruction for people or agents, generated from declarations.", "aliases": ["manual", "help"], "prohibitedMeanings": ["knowledge"]},
    {"termId": "T-PLACE", "canonicalName": "Place", "definition": "Any location at any scale, physical or not, from a coordinate to a galaxy.", "aliases": ["location", "region"], "prohibitedMeanings": ["deployment region"]},
    {"termId": "T-CALENDAR", "canonicalName": "Calendar", "definition": "A system for naming days and periods within a chronology.", "aliases": ["date system"], "prohibitedMeanings": ["time zone"]},
    {"termId": "T-QUANTITY", "canonicalName": "Quantity", "definition": "An amount of something measurable.", "aliases": ["amount"], "prohibitedMeanings": ["value"]},
    {"termId": "T-UNIT", "canonicalName": "Unit", "definition": "A declared standard in which a quantity is expressed.", "aliases": ["unit of measure"], "prohibitedMeanings": ["value unit"]},
    {"termId": "T-VALUE-UNIT", "canonicalName": "Value Unit", "definition": "Any unit in which value is held or exchanged.", "aliases": ["unit of value"], "prohibitedMeanings": ["price", "offer"]},
    {"termId": "T-EXPRESSION", "canonicalName": "Expression", "definition": "The rendering of a meaning in a language and script.", "aliases": ["wording", "translation"], "prohibitedMeanings": ["meaning"]},
    {"termId": "T-SCRIPT", "canonicalName": "Script", "definition": "A writing system and its direction.", "aliases": ["writing system"], "prohibitedMeanings": ["font"]},
    {"termId": "T-KIND", "canonicalName": "Kind", "definition": "A declared type of node within a domain.", "aliases": ["type"], "prohibitedMeanings": ["category"]},
    {"termId": "T-PERMISSION", "canonicalName": "Permission", "definition": "A grant to perform an action on a scope.", "aliases": ["grant"], "prohibitedMeanings": ["authority", "ownership"]},
    {"termId": "T-CREDENTIAL", "canonicalName": "Credential", "definition": "Proof presented to establish who is acting.", "aliases": ["sign-in method"], "prohibitedMeanings": ["permission"]},
    {"termId": "T-KEY", "canonicalName": "Key", "definition": "Secret material that encrypts, decrypts or signs.", "aliases": ["cryptographic key"], "prohibitedMeanings": ["identifier"]},
    {"termId": "T-AUDIT-RECORD", "canonicalName": "Audit Record", "definition": "An immutable entry recording who did what, when, where and why.", "aliases": ["audit log entry"], "prohibitedMeanings": ["evidence"]},
    {"termId": "T-OBLIGATION", "canonicalName": "Obligation", "definition": "A requirement a regulation places on the platform.", "aliases": ["requirement"], "prohibitedMeanings": ["policy"]},
    {"termId": "T-CONSENT", "canonicalName": "Consent", "definition": "A recorded permission from a person to process their data for a purpose.", "aliases": ["opt-in"], "prohibitedMeanings": ["permission"]},
    {"termId": "T-INTERFACE", "canonicalName": "Interface", "definition": "What a person sees and touches on a device.", "aliases": ["screen", "UI"], "prohibitedMeanings": ["API"]},
    {"termId": "T-DEVICE-TYPE", "canonicalName": "Device Type", "definition": "A declared kind of device with its capabilities.", "aliases": ["form factor"], "prohibitedMeanings": ["channel"]},
    {"termId": "T-MESSAGE", "canonicalName": "Message", "definition": "Content exchanged with a person over a communication channel.", "aliases": ["communication"], "prohibitedMeanings": ["event"]},
    {"termId": "T-CONVERSATION", "canonicalName": "Conversation", "definition": "A thread of messages between parties across channels.", "aliases": ["thread"], "prohibitedMeanings": ["workflow"]},
    {"termId": "T-COMMUNICATION-CHANNEL", "canonicalName": "Communication Channel", "definition": "A medium over which messages reach people.", "aliases": ["messaging channel"], "prohibitedMeanings": ["sales channel", "context"]},
    {"termId": "T-NOTIFICATION", "canonicalName": "Notification", "definition": "A decision that a recipient is told about an event, and when.", "aliases": ["alert"], "prohibitedMeanings": ["message delivery"]},
    {"termId": "T-SEARCH-INDEX", "canonicalName": "Search Index", "definition": "A declared structure that makes nodes findable.", "aliases": ["index for search"], "prohibitedMeanings": ["storage index"]},
    {"termId": "T-API", "canonicalName": "API", "definition": "The generated, versioned interface through which every capability is called.", "aliases": ["endpoint"], "prohibitedMeanings": ["interface"]},
    {"termId": "T-CONNECTOR", "canonicalName": "Connector", "definition": "A declared connection to an outside system.", "aliases": ["integration"], "prohibitedMeanings": ["communication channel"]},
    {"termId": "T-METRIC", "canonicalName": "Metric", "definition": "A declared measurement with a formula, unit and aggregation.", "aliases": ["measure"], "prohibitedMeanings": ["quantity"]},
    {"termId": "T-REPORT", "canonicalName": "Report", "definition": "A declared view over metrics and dimensions.", "aliases": ["dashboard"], "prohibitedMeanings": ["audit record"]},
    {"termId": "T-STORAGE", "canonicalName": "Storage", "definition": "Where declared data physically persists.", "aliases": ["database"], "prohibitedMeanings": ["registry"]},
    {"termId": "T-CACHE", "canonicalName": "Cache", "definition": "A derived, disposable copy kept for speed.", "aliases": ["cached copy"], "prohibitedMeanings": ["source of truth"]},
    {"termId": "T-INDEX", "canonicalName": "Index", "definition": "A derived access path over stored data.", "aliases": ["storage index"], "prohibitedMeanings": ["search index"]},
    {"termId": "T-ENVIRONMENT", "canonicalName": "Environment", "definition": "A named runtime configuration (development, staging, production, …).", "aliases": ["stage"], "prohibitedMeanings": ["context"]},
    {"termId": "T-DEPLOYMENT", "canonicalName": "Deployment", "definition": "A running placement of the platform in a region.", "aliases": ["release"], "prohibitedMeanings": ["place"]},
    {"termId": "T-VERIFICATION", "canonicalName": "Verification", "definition": "Proof that a declaration or build meets its requirements.", "aliases": ["check"], "prohibitedMeanings": ["evidence"]},
    {"termId": "T-TEST", "canonicalName": "Test", "definition": "An executable check run before a change ships.", "aliases": ["gate test"], "prohibitedMeanings": ["verification law"]},
    {"termId": "T-MEDIA-ASSET", "canonicalName": "Media Asset", "definition": "A file or media item attached to any entity.", "aliases": ["file", "media"], "prohibitedMeanings": ["interface"]},
    {"termId": "T-OFFERING", "canonicalName": "Offering", "definition": "The terms on which an option is provided: free, paid, metered, trial or included.", "aliases": ["plan option"], "prohibitedMeanings": ["commerce offer"]},
    {"termId": "T-PLAN", "canonicalName": "Plan", "definition": "A named bundle of offerings.", "aliases": ["subscription plan"], "prohibitedMeanings": ["blueprint"]},
    {"termId": "T-LICENCE", "canonicalName": "Licence", "definition": "The right a subscriber holds to read or use a published catalogue or package.", "aliases": ["license"], "prohibitedMeanings": ["permission"]},
    {"termId": "T-COMMERCE-PROJECTION", "canonicalName": "Commerce Projection", "definition": "A business concept (product, order, offer, …) projected from primitives; owns no truth.", "aliases": ["business entity"], "prohibitedMeanings": ["primitive"]},
    {"termId": "T-PACKAGE", "canonicalName": "Package", "definition": "A ready-made, editable composition of domains.", "aliases": ["bundle"], "prohibitedMeanings": ["offering"]},
    {"termId": "T-BLUEPRINT", "canonicalName": "Blueprint", "definition": "A package's declared setup questions and their owning domains.", "aliases": ["setup flow"], "prohibitedMeanings": ["plan"]},
    {"termId": "T-OVERLAY", "canonicalName": "Overlay", "definition": "A platform's recorded changes on top of an installed package version.", "aliases": ["customisation"], "prohibitedMeanings": ["fork"]},
    {"termId": "T-PARTY", "canonicalName": "Party", "definition": "Anyone or anything that acts: a platform, tenant, organisation, person, agent or provider.", "aliases": ["actor"], "prohibitedMeanings": ["identity", "role"]},
    {"termId": "T-ROLE", "canonicalName": "Role", "definition": "A part a party plays in a context: customer, seller, staff, carrier, partner, any declared.", "aliases": [], "prohibitedMeanings": ["permission", "party"]}
  ]
}
