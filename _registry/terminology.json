{
  "$schema": "https://ucos.io/registry/terminology.v1.json",
  "registryId": "UCOS-REG-TERMS",
  "canonicalName": "Canonical Terminology Registry",
  "version": "Omega-1",
  "status": "Constitutional Freeze",
  "ownerDomain": "Semantic Domain",
  "law": "No semantic term may exist with multiple meanings. No meaning may exist with multiple canonical definitions.",
  "terms": [
    { "termId": "T-EXISTENCE",  "canonicalName": "Existence",    "ownerDomain": "Universal Existence Kernel", "definition": "Anything that may exist.", "aliases": ["thing","object","item"], "prohibitedMeanings": ["business meaning","commercial meaning","operational meaning"], "nonExamples": ["Product","Service"] },
    { "termId": "T-ENTITY",     "canonicalName": "Entity",       "ownerDomain": "Identity Domain", "definition": "Technical representation of an Existence Object.", "aliases": ["record","row"], "prohibitedMeanings": ["existence itself"], "nonExamples": ["the actual product"] },
    { "termId": "T-KNOWLEDGE",  "canonicalName": "Knowledge",    "ownerDomain": "Knowledge Domain", "definition": "Interpreted information with evidence and meaning.", "aliases": ["validated understanding"], "prohibitedMeanings": ["data","information","evidence"], "nonExamples": ["a price feed","a timestamp"] },
    { "termId": "T-DATA",       "canonicalName": "Data",         "ownerDomain": "Observation Domain", "definition": "Raw observations.", "aliases": ["readings"], "prohibitedMeanings": ["knowledge","meaning"], "examples": ["price","timestamp","sensor reading"] },
    { "termId": "T-INFORMATION","canonicalName": "Information",  "ownerDomain": "Observation Domain", "definition": "Organized data.", "aliases": [], "prohibitedMeanings": ["knowledge"], "nonExamples": ["a validated assertion"] },
    { "termId": "T-EVIDENCE",   "canonicalName": "Evidence",     "ownerDomain": "Evidence Domain", "definition": "Proof supporting an assertion.", "aliases": ["proof"], "prohibitedMeanings": ["knowledge","trust"], "nonExamples": ["a computed trust score"] },
    { "termId": "T-TRUST",      "canonicalName": "Trust",        "ownerDomain": "Trust Domain", "definition": "Computed confidence in an assertion, derived from evidence.", "aliases": ["confidence"], "prohibitedMeanings": ["evidence","faith"], "nonExamples": ["a raw document"] },
    { "termId": "T-MEANING",    "canonicalName": "Meaning",      "ownerDomain": "Semantic Domain", "definition": "Semantic interpretation; higher-level understanding.", "aliases": ["semantics"], "prohibitedMeanings": ["classification","taxonomy","ontology"], "nonExamples": ["a category assignment"] },
    { "termId": "T-ONTOLOGY",   "canonicalName": "Ontology",     "ownerDomain": "Semantic Domain", "definition": "What exists.", "aliases": [], "prohibitedMeanings": ["taxonomy","classification"], "nonExamples": ["a product category tree"] },
    { "termId": "T-TAXONOMY",   "canonicalName": "Taxonomy",     "ownerDomain": "Semantic Domain", "definition": "How things are classified.", "aliases": [], "prohibitedMeanings": ["ontology","meaning"], "nonExamples": ["what exists"] },
    { "termId": "T-CLASSIFICATION","canonicalName": "Classification","ownerDomain": "Semantic Domain","definition": "Assignment into taxonomy.", "aliases": [], "prohibitedMeanings": ["meaning"], "nonExamples": ["semantic interpretation"] },
    { "termId": "T-RELATIONSHIP","canonicalName": "Relationship","ownerDomain": "Relationship Domain","definition": "Connection between objects.", "aliases": ["link","edge"], "prohibitedMeanings": ["causality"], "nonExamples": ["why A affects B"] },
    { "termId": "T-CAUSALITY",  "canonicalName": "Causality",    "ownerDomain": "Causality Domain", "definition": "Reason one object influences another.", "aliases": [], "prohibitedMeanings": ["relationship"], "nonExamples": ["a mere link"] },
    { "termId": "T-OBSERVATION","canonicalName": "Observation",  "ownerDomain": "Observation Domain","definition": "Captured reality.", "aliases": ["capture"], "prohibitedMeanings": ["inference"], "nonExamples": ["a derived pattern"] },
    { "termId": "T-INFERENCE",  "canonicalName": "Inference",    "ownerDomain": "Inference Domain", "definition": "Derived reality.", "aliases": ["discovery"], "prohibitedMeanings": ["observation"], "nonExamples": ["a raw sensor reading"] },
    { "termId": "T-SIMULATION", "canonicalName": "Simulation",   "ownerDomain": "Simulation Domain","definition": "Possible reality.", "aliases": ["scenario"], "prohibitedMeanings": ["reality"], "nonExamples": ["an actual transaction"] },
    { "termId": "T-PERSPECTIVE","canonicalName": "Perspective",  "ownerDomain": "Perspective Domain","definition": "Observer-specific interpretation.", "aliases": ["viewpoint"], "prohibitedMeanings": ["context"], "nonExamples": ["a jurisdiction boundary"] },
    { "termId": "T-CONTEXT",    "canonicalName": "Context",      "ownerDomain": "Context Domain", "definition": "Applicability boundary.", "aliases": ["scope"], "prohibitedMeanings": ["perspective"], "nonExamples": ["an observer's opinion"] },
    { "termId": "T-AUTHORITY",  "canonicalName": "Authority",    "ownerDomain": "Authority Domain", "definition": "Who has the right to govern.", "aliases": ["jurisdiction"], "prohibitedMeanings": ["ownership"], "nonExamples": ["who is responsible"] },
    { "termId": "T-OWNERSHIP",  "canonicalName": "Ownership",    "ownerDomain": "Authority Domain", "definition": "Who possesses responsibility.", "aliases": [], "prohibitedMeanings": ["authority"], "nonExamples": ["the right to govern"] },
    { "termId": "T-POLICY",     "canonicalName": "Policy",       "ownerDomain": "Policy Domain", "definition": "Behavioral governance.", "aliases": [], "prohibitedMeanings": ["rule"], "nonExamples": ["an executable constraint"] },
    { "termId": "T-RULE",       "canonicalName": "Rule",         "ownerDomain": "Rule Domain", "definition": "Executable constraint.", "aliases": [], "prohibitedMeanings": ["policy","decision"], "nonExamples": ["a governance statement"] },
    { "termId": "T-DECISION",   "canonicalName": "Decision",     "ownerDomain": "Decision Domain", "definition": "Outcome of evaluation.", "aliases": ["outcome"], "prohibitedMeanings": ["rule"], "nonExamples": ["an executable constraint"] },
    { "termId": "T-EVENT",      "canonicalName": "Event",        "ownerDomain": "Runtime", "definition": "Something that occurred.", "aliases": ["occurrence"], "prohibitedMeanings": ["state"], "nonExamples": ["current condition"] },
    { "termId": "T-STATE",      "canonicalName": "State",        "ownerDomain": "Runtime", "definition": "Current condition.", "aliases": ["condition"], "prohibitedMeanings": ["event"], "nonExamples": ["something that occurred"] },
    { "termId": "T-CAPABILITY", "canonicalName": "Capability",   "ownerDomain": "Constitutional Authority", "definition": "What may be performed.", "aliases": [], "prohibitedMeanings": ["process"], "nonExamples": ["a sequence of execution"] },
    { "termId": "T-PROCESS",    "canonicalName": "Process",      "ownerDomain": "Runtime", "definition": "Sequence of execution.", "aliases": [], "prohibitedMeanings": ["capability","workflow"], "nonExamples": ["what may be performed"] },
    { "termId": "T-WORKFLOW",   "canonicalName": "Workflow",     "ownerDomain": "Runtime", "definition": "Orchestrated process.", "aliases": [], "prohibitedMeanings": ["process"], "nonExamples": ["an unorchestrated sequence"] },
    { "termId": "T-TWIN",       "canonicalName": "Digital Twin", "ownerDomain": "Twin Domain", "definition": "Digital representation of reality.", "aliases": ["twin"], "prohibitedMeanings": ["reality"], "nonExamples": ["the physical asset"] },
    { "termId": "T-AGENT",      "canonicalName": "Agent",        "ownerDomain": "Agent Domain", "definition": "Autonomous actor operating under governance.", "aliases": [], "prohibitedMeanings": ["user","service","process"], "nonExamples": ["a human","a microservice"] },
    { "termId": "T-PROJECTION", "canonicalName": "Projection",   "ownerDomain": "Runtime", "definition": "Runtime representation derived from primitives; never owns truth.", "aliases": ["derived view"], "prohibitedMeanings": ["primitive","source of truth"], "examples": ["Product","Service","Offer","Contract"], "nonExamples": ["a registry entry"] }
  ],
  "conflictResolution": "On any collision, the Semantic Domain registry is authoritative. All other usages are void."
}
