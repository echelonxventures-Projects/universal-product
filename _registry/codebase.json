{
  "$schema": "https://ucos.io/registry/codebase.v1.json",
  "registryId": "UCOS-REG-CODEBASE",
  "canonicalName": "Code Module Ownership Registry",
  "version": "Omega-1",
  "status": "Constitutional Freeze",
  "ownerDomain": "Registry",
  "law": "LAW-002 Knowledge Once — every code module has exactly one owning domain; a module that mixes concerns is split into parts, each with one owner.",
  "covers": ["server.js", "lib/*.js", "lib/seed/*.json", "public/js/*.js", "public/docs/*", "scripts/*"],
  "modules": [
    {"path": "server.js", "owner": "Integration", "note": "the HTTP entry point"},
