    {"path": "lib/meta.js", "owner": "Registry"},
    {"path": "lib/parity-registries.js", "owner": "Registry"},
    {"path": "lib/registry.js", "parts": [{"owner": "Registry", "part": "registry lists: seed, read, save, delete, upgrade, defaults"}, {"owner": "Geo", "part": "countries and subdivisions: seed, repair, reconcile, profile, withdraw"}, {"owner": "Value", "part": "currencies and exchange rates"}, {"owner": "Integration", "part": "provider definitions, availability and exemptions"}, {"owner": "Rule", "part": "tax modes"}, {"owner": "Package", "part": "platform kinds"}, {"owner": "Relationship", "part": "link reconciliation"}]},
    {"path": "lib/global.js", "parts": [{"owner": "Geo", "part": "countries and a store's country"}, {"owner": "Value", "part": "currencies and a store's currency"}, {"owner": "Integration", "part": "providers and their availability, a store's providers"}, {"owner": "Offering", "part": "plans and a store's plan"}, {"owner": "Context", "part": "global settings"}]},
    {"path": "lib/canonical.js", "owner": "Registry"},
