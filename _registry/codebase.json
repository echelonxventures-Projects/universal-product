    {"path": "lib/stores.js", "owner": "Party", "note": "stores on the kernel: the places each store serves (a Relationship hierarchy, time-windowed) and its jurisdiction (a Party setting) (P09)"},
    {"path": "lib/places.js", "owner": "Geo", "note": "the place tree on the kernel; the write path for countries and subdivisions, and the import of rows it has never seen (P09)"},
