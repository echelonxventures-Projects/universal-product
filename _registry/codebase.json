    {"path": "lib/kernel-shape.js", "owner": "Geo", "note": "kernel part K05: coordinate systems and shapes"},
    {"path": "lib/kernel-lifecycle.js", "owner": "Evolution", "note": "kernel part K09: changes and node states"},
    {"path": "lib/platform-setup.js", "owner": "Package", "note": "configuring a platform by its setup steps: answers on the kernel to the minute, applied as they come due"},
