    {"path": "lib/kernel-context.js", "parts": [{"owner": "Context", "part": "scope and resolution (K11, K12)"}, {"owner": "Perspective", "part": "views (K10)"}]},
    {"path": "lib/expression.js", "owner": "Expression", "note": "languages, the message catalogue, and the language a request is answered in (P12)"},
