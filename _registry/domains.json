{
  "$schema": "https://ucos.io/registry/domains.v1.json",
  "registryId": "UCOS-REG-DOMAINS",
  "canonicalName": "Domain Ownership & Contract Registry",
  "version": "Omega-1",
  "status": "Constitutional Freeze",
  "ownerDomain": "Constitutional Authority",
  "law": "No concept may exist without ownership. No overlap may exist between constitutional domains. No cross-domain ownership permitted.",
  "dependencyLaw": "Identity -> Knowledge -> Relationships -> Context -> Policy -> Trust -> Projection. Forbidden: circular dependencies, mutual ownership, cross-domain state mutation.",
  "communication": "All cross-domain communication occurs exclusively through explicit contracts. No domain may access another domain's internals.",
  "boundaries": {"noDomainMay": ["Modify another domain directly", "Bypass authority", "Bypass policies", "Bypass trust", "Bypass governance", "Interpret another domain's internals"], "projectionLaw": "Products, services, offers, subscriptions, contracts are projections. No projection may own truth. Truth belongs only to constitutional domains."},
  "categories": [
    {"categoryId": "C01", "name": "Constitution", "covers": "The laws, amendments and certification law that govern every other category."},
    {"categoryId": "C02", "name": "Meaning", "covers": "What exists, what it is called, and what is known about it."},
    {"categoryId": "C03", "name": "Reality and Reasoning", "covers": "How reality is observed, evidenced, explained, simulated and changed."},
    {"categoryId": "C04", "name": "Universal Dimensions", "covers": "The coordinates any fact is placed in: where, when, how much, what value, in which expression, in what context."},
    {"categoryId": "C05", "name": "Structure", "covers": "How declarations are stored once and linked."},
    {"categoryId": "C06", "name": "Decision and Control", "covers": "Who may decide, under which policy and rule, and what was decided."},
    {"categoryId": "C07", "name": "Assurance", "covers": "Protection, computed trust, the immutable record, and obligations."},
    {"categoryId": "C08", "name": "Interaction", "covers": "How people see, are told, converse and find."},
    {"categoryId": "C09", "name": "Automation", "covers": "How work runs: events, state, workflows, agents and connections."},
    {"categoryId": "C10", "name": "Intelligence", "covers": "Measurement of the platform and the business."},
    {"categoryId": "C11", "name": "Platform", "covers": "Storing, running, verifying, holding content and offering the platform."},
    {"categoryId": "C12", "name": "Business", "covers": "Business projections composed from the domains; they own no truth."},
    {"categoryId": "C13", "name": "Composition", "covers": "Ready-made, editable compositions of domains."}
  ],
  "laws": [
    {"lawId": "LAW-001", "name": "Zero Hard Coding", "statement": "No product, service, offer, contract, currency, country, language, industry or marketplace concept may appear as a schema type. They are projections.", "enforcedBy": "_registry/audit.js"},
    {"lawId": "LAW-002", "name": "Knowledge Once", "statement": "Every concept is defined exactly once: every artifact ID, primitive, term and owner is unique, and nothing is stated twice.", "enforcedBy": "_registry/gate.js, _registry/audit.js"},
    {"lawId": "LAW-003", "name": "Projection Law", "statement": "Documents are projected from the registry, never authored. Editing a projected document is a violation; change the registry and re-project.", "enforcedBy": "_registry/project.js, _registry/audit.js"},
    {"lawId": "LAW-005", "name": "Explainability", "statement": "Every artifact answers what happened, who authorized it, which policy allowed it, what evidence supports it, and with what confidence.", "enforcedBy": "_registry/audit.js"}
  ],
  "amendments": [
    {"amendmentId": "AMD-0001", "date": "2026-10-17", "authorisedBy": "Platform owner", "summary": "Unifies the registry under one categorised ownership spine: 13 categories; every domain in exactly one category; every primitive and term owned by exactly one domain (ownership stated only here); the four undeclared owners resolved (Constitutional Authority and Runtime declared as domains, Perspective and Possibility declared, Existence owned by Identity); new domains for the platform; every artifact owned by one domain.", "changes": ["domains.json: categories, category per domain, 28 domains added, owns completed", "primitives.json: owner field removed (ownership is declared once, in domains.json)", "terminology.json: ownerDomain removed; terms added for newly owned names", "manifest.json: owner per artifact"]},
    {"amendmentId": "AMD-0002", "date": "2026-10-17", "authorisedBy": "Platform owner", "summary": "Writes the 17 missing domain contracts (Decision, Geo, Time, Measure, Value, Expression, Registry, Compliance, Experience, Communication, Notification, Guidance, Integration, Insight, Content, Offering, Package) into the registry, replacing FOUNDATIONS.md as their source; documents are filed by the owning domain's register category, so the manifest's separate document categories are retired.", "changes": ["content-platform.json: 17 content blocks", "content-map.json: 17 routes", "manifest.json: 17 artifacts; categories, totalArtifacts and per-artifact cat removed", "domains.json: contracts set"]},
    {"amendmentId": "AMD-0003", "date": "2026-10-17", "authorisedBy": "Platform owner", "summary": "One master document: the registry projects UCOS-MASTER.md and one volume per register category, replacing the per-artifact files and the repository index; the enforced laws become registry data.", "changes": ["domains.json: laws", "project.js: master and volumes", "audit.js: checks the master and volumes", "UCOS-REPOSITORY-INDEX.md: folded into the master"]}
  ],
