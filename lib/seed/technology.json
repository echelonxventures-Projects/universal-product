{
 "$comment": "Technology governance (lib/technology.js, PR-053). Every technology the platform uses or may use — a runtime, a library, an image, a database engine, a browser, a CI action, or a category nobody has named yet — is a kernel node, its facts versioned in k_versions and its production-affecting moves made through the kernel's change lifecycle. Nothing here is a closed list the code enumerates: categories, sources, trust levels, states, classes, detectors and uses are data, and a new one is a new entry. Discovery records facts and never confers compatibility; evaluation is computed from requirements, metadata and evidence; approval and activation are governed changes approved by someone other than their author. The repository's own toolchain is resolved from this registry into technology.lock.json (generated by node scripts/technology.js lock), which CI, the build and the checks consume or are validated against. Snapshots of what the sources returned are in lib/seed/technology-discovered.json.",
 "namespace": "platform",
 "owner": "Runtime",
 "actors": { "seed": "technology.seed", "discovery": "technology.discovery", "evaluator": "technology.evaluator" },
 "lock": "technology.lock.json",
 "snapshots": "lib/seed/technology-discovered.json",
 "inventoryFile": "TECHNOLOGY_INVENTORY.generated.md",
 "titleMax": 200,
 "events": { "ingested": "technology.discovery.ingested" },

 "kinds": {
  "category": { "kind": "technology.category", "scheme": "technology.category.key", "label": "Technology category",
   "attributes": [
    { "key": "key", "type": "text", "required": true, "label": "Key" },
    { "key": "label", "type": "text", "required": true, "label": "Name" },
    { "key": "scheme", "type": "text", "required": true, "label": "How its versions are compared" },
    { "key": "contract", "type": "record", "label": "Metadata contract: { attributes: [{ key, type, required, constraints }], integrity: required|optional }" },
    { "key": "note", "type": "text", "label": "Note", "constraints": { "maxLength": 500 } } ] },
  "item": { "kind": "technology.item", "scheme": "technology.item.key", "label": "Technology",
   "attributes": [
    { "key": "key", "type": "text", "required": true, "label": "Key" },
    { "key": "category", "type": "text", "required": true, "label": "Category key" },
    { "key": "label", "type": "text", "required": true, "label": "Name" },
    { "key": "supplier", "type": "text", "label": "Supplier" },
    { "key": "origin", "type": "text", "label": "Where it comes from" },
    { "key": "licence", "type": "text", "label": "Licence" },
    { "key": "sources", "type": "list", "label": "Sources allowed to report its releases" },
    { "key": "capabilities", "type": "list", "label": "What its releases provide: [{ key, since, until, note }]" },
    { "key": "lines", "type": "record", "label": "Release lines and their support: { <line>: { endOfLife } }" },
    { "key": "constraints", "type": "list", "label": "Operational constraints" },
    { "key": "note", "type": "text", "label": "Note", "constraints": { "maxLength": 500 } } ] },
  "release": { "kind": "technology.release", "scheme": "technology.release.key", "label": "Technology release",
   "attributes": [
    { "key": "key", "type": "text", "required": true, "label": "Key (<item>@<version>)" },
    { "key": "item", "type": "text", "required": true, "label": "Item key" },
    { "key": "version", "type": "text", "required": true, "label": "Version" },
    { "key": "state", "type": "text", "required": true, "label": "Lifecycle state", "lifecycle": true },
    { "key": "channel", "type": "text", "label": "Release channel" },
    { "key": "artifacts", "type": "list", "label": "Artifacts: [{ name, sha256 | digest | commit, platform }]" },
    { "key": "metadata", "type": "record", "label": "Facts its sources reported, per the category's contract" },
    { "key": "dependencies", "type": "list", "label": "What it needs: [{ item, version | range }]" },
    { "key": "advisories", "type": "list", "label": "Advisories: [{ key, severity, source, note }]" },
    { "key": "provenance", "type": "list", "label": "Where its facts came from: [{ source, protocol, location, fetchedAt, payloadSha256 }]" },
    { "key": "evidence", "type": "list", "label": "Test and verification evidence: [{ kind, outcome, ref, commit, at, by }]" },
    { "key": "evaluation", "type": "record", "label": "The last evaluation report" },
    { "key": "replaced_by", "type": "text", "label": "The release that replaces it" },
    { "key": "reason", "type": "text", "label": "Why it was moved", "constraints": { "maxLength": 500 } } ] },
  "resolution": { "kind": "technology.resolution", "scheme": "technology.resolution.use", "label": "Technology resolution",
   "attributes": [
    { "key": "use", "type": "text", "required": true, "label": "Use" },
    { "key": "releases", "type": "list", "required": true, "label": "The releases resolved for the use, with artifact, provenance and evidence" },
    { "key": "basis", "type": "text", "label": "Why", "constraints": { "maxLength": 500 } } ] }
 },

 "states": {
  "initial": "discovered",
  "list": [
   { "key": "discovered", "label": "Discovered — a source reported it; nothing is known about fitness", "automatic": true },
   { "key": "candidate", "label": "Candidate — its identity and provenance check out", "automatic": true },
   { "key": "under-evaluation", "label": "Under evaluation — the evaluator has run and something is still missing", "automatic": true },
   { "key": "compatible", "label": "Compatible — meets the declared requirements of at least one use; not yet proven", "automatic": true },
   { "key": "verified", "label": "Verified — compatible and carrying the evidence a use requires", "automatic": true },
   { "key": "approved", "label": "Approved — may be resolved for a use (a governed change)", "governed": true, "usable": true },
   { "key": "active", "label": "Active — resolved for at least one use (a governed change)", "governed": true, "usable": true },
   { "key": "deprecated", "label": "Deprecated — to be replaced; still resolvable until it is (a governed change)", "governed": true, "usable": true },
   { "key": "rejected", "label": "Rejected — failed a check that cannot be waived", "automatic": true },
   { "key": "prohibited", "label": "Prohibited — may not be used (a governed change)", "governed": true }
  ],
  "transitions": {
   "discovered": ["candidate", "rejected"],
   "candidate": ["under-evaluation", "compatible", "verified", "rejected"],
   "under-evaluation": ["compatible", "verified", "rejected"],
   "compatible": ["verified", "under-evaluation", "rejected", "approved"],
   "verified": ["approved", "compatible", "under-evaluation", "rejected"],
   "approved": ["active", "deprecated", "prohibited"],
   "active": ["deprecated", "prohibited", "approved"],
   "deprecated": ["active", "prohibited"],
   "rejected": ["candidate"],
   "prohibited": []
  },
  "named": { "discovered": "discovered", "candidate": "candidate", "underEvaluation": "under-evaluation", "compatible": "compatible", "verified": "verified", "approved": "approved", "active": "active", "deprecated": "deprecated", "rejected": "rejected", "prohibited": "prohibited" },
  "evaluable": ["compatible", "verified", "approved"],
  "upgradable": ["verified", "approved"],
  "replaceable": ["deprecated", "prohibited"],
  "needsReason": ["deprecated", "prohibited"],
  "resolvable": ["approved", "active", "deprecated"],
  "approvable": ["verified"]
 },

 "trust": {
  "$comment": "A source's trust level says what its reports may do. No level confers compatibility or approval: a report is only facts.",
  "levels": [
   { "key": "authoritative", "label": "The supplier's own release feed or registry", "mayDiscover": true },
   { "key": "generated-resolution", "label": "A resolution artifact a package manager generated (a lockfile)", "mayDiscover": true },
   { "key": "declared", "label": "Facts a maintainer declared from an observation (a CI log, an image's configuration)", "mayDiscover": true, "warn": "declared, not reported by an authoritative feed" },
   { "key": "untrusted", "label": "Anything else", "mayDiscover": false }
  ],
  "maxEntryBytes": 65536,
  "maxEntries": 5000,
  "forbiddenKeys": ["__proto__", "constructor", "prototype"],
  "extensionPrefix": "x-",
  "digest": { "sha256": "^[0-9a-f]{64}$", "sha512": "^[0-9a-f]{128}$", "digest": "^sha(256|512):[0-9a-f]{64,128}$", "commit": "^[0-9a-f]{40}$", "integrity": "^sha(256|384|512)-[A-Za-z0-9+/]+={0,2}$" }
 },

 "policy": {
  "$comment": "What evaluation weighs. blocking: advisory severities that keep a release out of a production use. licensed: the categories whose releases must carry an allowed licence. licences: the licences they may carry.",
  "blockingSeverities": ["critical", "high", "security-release"],
  "licensed": ["library"],
  "licences": ["MIT", "MIT-0", "ISC", "Apache-2.0", "BSD-2-Clause", "BSD-3-Clause", "BlueOak-1.0.0", "CC0-1.0", "0BSD"],
  "endOfLifeWarningDays": 120
 },

 "categories": [
  { "key": "runtime", "label": "Language runtime", "scheme": "dotted",
    "contract": { "integrity": "required", "attributes": [
     { "key": "date", "type": "text" }, { "key": "support", "type": "text" }, { "key": "securityRelease", "type": "boolean" },
     { "key": "npm", "type": "text" }, { "key": "modules", "type": "text" }, { "key": "platforms", "type": "list" } ] } },
  { "key": "package-manager", "label": "Package manager", "scheme": "dotted", "contract": { "integrity": "optional", "attributes": [ { "key": "bundledWith", "type": "text" } ] } },
  { "key": "library", "label": "Library", "scheme": "dotted",
    "contract": { "integrity": "required", "attributes": [
     { "key": "scope", "type": "text", "required": true, "constraints": { "oneOf": ["runtime", "development"] } },
     { "key": "engines", "type": "record" }, { "key": "licence", "type": "text" }, { "key": "resolved", "type": "text" } ] } },
  { "key": "container-image", "label": "Container image", "scheme": "opaque",
    "contract": { "integrity": "required", "attributes": [ { "key": "reference", "type": "text", "required": true }, { "key": "repository", "type": "text" }, { "key": "tag", "type": "text" } ] } },
  { "key": "database-engine", "label": "Database engine", "scheme": "dotted", "contract": { "integrity": "optional", "attributes": [] } },
  { "key": "browser", "label": "Web browser", "scheme": "dotted", "contract": { "integrity": "optional", "attributes": [] } },
  { "key": "ci-runner-image", "label": "CI runner image", "scheme": "opaque", "contract": { "integrity": "optional", "attributes": [ { "key": "imageVersion", "type": "text" } ] } },
  { "key": "ci-action", "label": "CI action", "scheme": "opaque", "contract": { "integrity": "required", "attributes": [ { "key": "repository", "type": "text", "required": true }, { "key": "tag", "type": "text" } ] } },
  { "key": "tool", "label": "Command-line tool", "scheme": "opaque", "contract": { "integrity": "optional", "attributes": [] } }
 ],

 "sources": [
  { "key": "node-release-index", "protocol": "release-index", "trust": "authoritative", "item": "node", "bundles": "npm", "location": "https://nodejs.org/dist/index.json" },
  { "key": "node-release-checksums", "protocol": "checksum-list", "trust": "authoritative", "item": "node", "location": "https://nodejs.org/dist/v{version}/SHASUMS256.txt" },
  { "key": "container-registry", "protocol": "image-index", "trust": "authoritative", "location": "docker.io/library", "items": { "node": "node-image", "postgres": "postgres-image", "redis": "redis-image" } },
  { "key": "action-tags", "protocol": "git-tag", "trust": "authoritative", "location": "https://github.com/{repository}", "items": { "actions/checkout": "action-checkout", "actions/setup-node": "action-setup-node" } },
  { "key": "npm-lockfile", "protocol": "npm-lockfile", "trust": "generated-resolution", "location": "package-lock.json", "file": true, "category": "library" },
  { "key": "declaration", "protocol": "declaration", "trust": "declared", "location": "lib/seed/technology.json" }
 ],

 "items": [
  { "key": "node", "category": "runtime", "label": "Node.js", "supplier": "OpenJS Foundation", "origin": "https://nodejs.org", "licence": "MIT",
    "sources": ["node-release-index", "node-release-checksums"],
    "capabilities": [
     { "key": "builtin-module:node:sqlite", "since": "22.13.0", "note": "built in and unflagged; 22.5–22.12 hide it behind --experimental-sqlite (lib/db.js)" },
     { "key": "builtin-module:node:worker_threads", "since": "12.0.0", "note": "the synchronous PostgreSQL bridge (lib/pgbridge.js)" } ],
    "lines": { "22": { "endOfLife": "2027-04-30" }, "24": { "endOfLife": "2028-04-30" }, "26": { "endOfLife": "2029-04-30" } } },
  { "key": "npm", "category": "package-manager", "label": "npm", "supplier": "npm (bundled with the runtime)", "origin": "https://www.npmjs.com", "licence": "Artistic-2.0",
    "sources": ["node-release-index"], "capabilities": [ { "key": "lockfile:3", "since": "7.0.0", "note": "package-lock.json lockfileVersion 3" } ] },
  { "key": "node-image", "category": "container-image", "label": "Node.js official container image", "supplier": "Docker Official Images", "origin": "docker.io/library/node", "sources": ["container-registry"] },
  { "key": "postgres-image", "category": "container-image", "label": "PostgreSQL official container image", "supplier": "Docker Official Images", "origin": "docker.io/library/postgres", "sources": ["container-registry"] },
  { "key": "redis-image", "category": "container-image", "label": "Redis official container image", "supplier": "Docker Official Images", "origin": "docker.io/library/redis", "sources": ["container-registry"] },
  { "key": "postgresql", "category": "database-engine", "label": "PostgreSQL", "supplier": "PostgreSQL Global Development Group", "origin": "https://www.postgresql.org", "licence": "PostgreSQL",
    "sources": ["declaration"], "capabilities": [ { "key": "auth:scram-sha-256", "since": "10.0" }, { "key": "wire-protocol:3", "since": "7.4" } ] },
  { "key": "chrome", "category": "browser", "label": "Chrome or Chromium (headless)", "supplier": "the CI runner image", "sources": ["declaration"], "note": "the runner image provides it; its version is printed by the browser job but not pinned" },
  { "key": "ubuntu-runner", "category": "ci-runner-image", "label": "Hosted CI runner image", "supplier": "the CI provider", "sources": ["declaration"], "note": "a label the provider moves between image versions; observed versions are evidence, not a pin" },
  { "key": "action-checkout", "category": "ci-action", "label": "Checkout action", "supplier": "the CI provider", "origin": "https://github.com/actions/checkout", "licence": "MIT", "sources": ["action-tags"] },
  { "key": "action-setup-node", "category": "ci-action", "label": "Runtime setup action", "supplier": "the CI provider", "origin": "https://github.com/actions/setup-node", "licence": "MIT", "sources": ["action-tags"] },
  { "key": "jq", "category": "tool", "label": "jq", "supplier": "the CI runner image", "sources": ["declaration"], "note": "the bootstrap reader of technology.lock.json in CI" }
 ],

 "requirements": [
  { "key": "platform.runtime", "label": "What the platform needs from its runtime", "item": "node", "capabilities": ["builtin-module:node:sqlite", "builtin-module:node:worker_threads"], "libraries": "runtime", "blocking": true },
  { "key": "platform.development", "label": "What the test and browser tooling declares it needs", "item": "node", "libraries": "development", "blocking": false,
    "note": "advisory: jsdom and its dependencies declare narrower engine ranges than the production floor; a lane outside them proves the runtime floor and reports the range as a finding" },
  { "key": "platform.install", "label": "What installing needs from the package manager", "item": "npm", "capabilities": ["lockfile:3"], "via": "npm", "blocking": true },
  { "key": "platform.database", "label": "What the PostgreSQL driver needs from the server", "item": "postgresql", "capabilities": ["auth:scram-sha-256", "wire-protocol:3"], "blocking": true }
 ],

 "uses": [
  { "key": "deploy.container", "label": "The production container's base image", "production": true, "item": "node-image", "requires": ["platform.runtime", "platform.install"], "evidence": ["ci-suite", "container-smoke"], "count": 1 },
  { "key": "ci.test", "label": "The runtime lanes of the test job", "production": false, "item": "node", "requires": ["platform.runtime", "platform.install"], "advisory": ["platform.development"], "evidence": ["ci-suite"],
    "platform": "linux-x64", "evaluate": { "eligible": { "support": ["lts"] }, "perLine": "highest", "max": 3 } },
  { "key": "ci.database", "label": "The PostgreSQL service of the postgres job", "production": false, "item": "postgres-image", "requires": ["platform.database"], "evidence": ["ci-postgres"], "count": 1 },
  { "key": "ci.actions", "label": "The actions every CI job runs", "production": false, "category": "ci-action", "evidence": ["ci-run"] },
  { "key": "ci.runner", "label": "The runner image every CI job runs on (and the bootstrap)", "production": false, "item": "ubuntu-runner", "evidence": ["ci-run"], "count": 1 },
  { "key": "build.libraries", "label": "The libraries npm installs", "production": true, "category": "library", "from": "npm-lockfile" }
 ],
 "derived": {
  "$comment": "Values computed from the registry instead of declared twice: the runtime the browser and postgres jobs use is the one the production image carries; the primary test lane is that same runtime.",
  "ci.runtime": { "from": "deploy.container", "dependency": "node" }
 },

 "bootstrap": {
  "$comment": "The resolver cannot run before something runs it. In CI the resolve job reads technology.lock.json with the runner image's jq before any runtime is set up; every later job installs the runtime the lock names and checks it is that release. Locally and in the test lanes the lock is generated and checked by node scripts/technology.js, which needs a runtime that meets platform.runtime (it boots the kernel on a scratch database).",
  "ci": { "runner": "ci.runner", "reader": "jq", "file": "technology.lock.json" },
  "local": { "requires": "platform.runtime", "command": "node scripts/technology.js check" }
 },

 "declared": [
  { "item": "postgresql", "version": "16.15", "metadata": { "x-observed": "PG_VERSION=16.15-1.pgdg13+2 in the linux/amd64 configuration of postgres:16@sha256:1beaa308…" } },
  { "item": "ubuntu-runner", "version": "ubuntu-24.04", "metadata": { "imageVersion": "20261025.353.1" } },
  { "item": "jq", "version": "runner-provided" }
 ],

