   { "release": "node@22.23.4", "kind": "ci-suite", "outcome": "pass", "ref": "github-actions run 40877050799 attempt 2 job 123483407930", "commit": "2ff2b4a8f95d265f6669a7c016f7e96df4fdf1d3", "at": "2026-10-29T14:29:32Z" },
