 "changes": [],

 "classes": [
  { "key": "unjustified-hardcoding", "label": "Unjustified hardcoding — remove it", "violation": true },
  { "key": "duplicated-configuration", "label": "Duplicated configuration — consolidate it", "violation": true },
  { "key": "generated-resolution", "label": "A generated resolution artifact" },
  { "key": "consumes-resolution", "label": "Reads, or is validated against, the generated resolution" },
  { "key": "technical-constraint", "label": "A genuine technical minimum or immutable constraint, governed by a requirement" },
  { "key": "adapter", "label": "A required adapter or integration" },
  { "key": "diagnostic", "label": "Reports the technology in use; decides nothing" },
  { "key": "documented-exception", "label": "A documented exception — needs a recorded approval", "needsApproval": true },
  { "key": "unverified-assumption", "label": "An unsupported or unverified assumption — reported as a gap", "gap": true }
 ],

 "scan": {
  "$comment": "Where the repository states technology assumptions, and how to find them. Each detector is a pattern over a set of files (globs); comments are stripped first (js: /* */ and //; hash: #). A finding is (file, detector, token). Every finding must be covered by an inventory entry; an entry nothing matches any more is stale. A new detector or file type is a new entry here.",
  "js": ["*.js", "**/*.js", "*.mjs", "**/*.mjs", "*.cjs", "**/*.cjs"],
  "detectors": [
   { "key": "ci-runtime", "files": [".github/workflows/*.yml"], "comments": "hash", "pattern": "node-version:\\s*(\\S[^\\n]*?)\\s*$" },
   { "key": "ci-runner", "files": [".github/workflows/*.yml"], "comments": "hash", "pattern": "runs-on:\\s*(\\S+)" },
   { "key": "ci-action", "files": [".github/workflows/*.yml"], "comments": "hash", "pattern": "uses:\\s*([^\\s#]+)" },
   { "key": "container-image", "files": [".github/workflows/*.yml", "docker-compose*.yml"], "comments": "hash", "pattern": "image:\\s*(\\S[^\\n]*?)\\s*$" },
   { "key": "container-base", "files": ["Dockerfile*"], "comments": "hash", "pattern": "^FROM\\s+(\\S+)" },
   { "key": "engine-range", "files": ["package.json"], "json": "engines" },
   { "key": "dependency", "files": ["package.json"], "json": "dependencies,devDependencies,optionalDependencies,peerDependencies", "keys": true },
   { "key": "module", "files": "js", "comments": "js", "pattern": "require\\(\\s*[\"']([^\"'./][^\"']*)[\"']\\s*\\)" },
   { "key": "runtime-introspection", "files": "js", "comments": "js", "pattern": "(process\\.versions?(?:\\.[a-z0-9_]+)?)" },
   { "key": "runtime-flag", "files": ["server.js", "lib/*.js", "scripts/*.js", "test/*.js", ".github/workflows/*.yml", "package.json", "systemd/*", "*.sh", "Dockerfile*", "docker-compose*.yml"], "pattern": "(--experimental-[a-z-]+|--harmony[a-z-]*|--no-experimental-[a-z-]+)" },
   { "key": "url-scheme", "files": ["server.js", "lib/*.js", "lib/routes/*.js", "scripts/*.js"], "comments": "js", "pattern": "\\b([a-z][a-z0-9+.-]*):\\/\\/" },
   { "key": "host-binary", "files": ["systemd/*", "*.sh"], "comments": "none", "pattern": "(?:ExecStart=|^#!)\\s*(\\S+)" },
   { "key": "browser-binary", "files": ["scripts/*.js", "test/*.js", ".github/workflows/*.yml"], "pattern": "((?:google-chrome|chromium)[a-z-]*|[A-Z][A-Za-z ]*\\.app)\\b" }
  ]
 },

 "inventory": [
  { "id": "TA-01", "detector": "ci-runtime", "tokens": ["${{ matrix.version }}", "${{ needs.resolve.outputs.node }}"], "files": [".github/workflows/ci.yml"], "class": "consumes-resolution", "governedBy": "ci.test",
    "why": "every job installs the runtime technology.lock.json resolves (the test lanes from ci.test, the browser and postgres jobs the runtime the production image carries); before PR-053 the workflow listed 22.13, 22 and 24 itself and let 22 and 24 float to whatever the runner cached" },
  { "id": "TA-02", "detector": "ci-runner", "tokens": ["ubuntu-24.04"], "files": [".github/workflows/ci.yml"], "class": "unverified-assumption", "governedBy": "ci.runner",
    "why": "the hosted runner label is the bootstrap; the provider moves it between image versions, so the image version is recorded as evidence (20261025.353.1 in run 40877050799), not pinned. scripts/technology.js check validates the label against the lock" },
  { "id": "TA-03", "detector": "ci-action", "tokens": ["actions/checkout@fbc6f3992d24b796d5a048ff273f7fcc4a7b6c09", "actions/setup-node@a0853c24544627f65ddf259abe73b1d18a591444"], "files": [".github/workflows/ci.yml"], "class": "consumes-resolution", "governedBy": "ci.actions",
    "why": "pinned to the commits their v5 tags pointed at (the same commits run 40877050799 downloaded); a workflow uses: line cannot be an expression, so the check validates each against the lock" },
  { "id": "TA-04", "detector": "container-image", "tokens": ["${{ needs.resolve.outputs.postgres }}"], "files": [".github/workflows/ci.yml"], "class": "consumes-resolution", "governedBy": "ci.database",
    "why": "the PostgreSQL service image is the digest the lock resolves; it was the floating tag postgres:16" },
  { "id": "TA-05", "detector": "container-image", "tokens": ["redis:7-alpine"], "files": ["docker-compose.yml"], "class": "unverified-assumption",
    "why": "the optional queue's image in the compose example: a floating tag, never exercised by CI (no test runs the Redis queue). Its current digest is in the discovery snapshot; resolving it needs a test that runs the queue" },
  { "id": "TA-06", "detector": "container-base", "tokens": ["node:22.23.4-alpine@sha256:fe4f6d74e20370acb04ad889077d14d0f64a9c8ea6a42bc60cddf1e844699914"], "files": ["Dockerfile"], "class": "consumes-resolution", "governedBy": "deploy.container",
    "why": "a Dockerfile FROM cannot read a file a plain docker build does not pass in, so the base stays written and the check validates it against the deploy.container resolution (tag and digest)" },
  { "id": "TA-07", "detector": "engine-range", "tokens": ["node:>=22.13.0"], "files": ["package.json"], "class": "technical-constraint", "governedBy": "platform.runtime",
    "why": "the floor is derived: the highest `since` among the capabilities platform.runtime needs (node:sqlite unflagged, 22.13.0). The check fails when package.json says anything else" },
  { "id": "TA-08", "detector": "dependency", "tokens": ["bull", "ioredis", "prom-client", "jsdom"], "files": ["package.json"], "class": "generated-resolution", "governedBy": "build.libraries",
    "why": "declared ranges; package-lock.json (npm's generated resolution, ingested by the npm-lockfile adapter) pins each release and its integrity, and its digest is part of the lock" },
  { "id": "TA-09", "detector": "module", "tokens": ["node:sqlite", "node:worker_threads"], "files": ["**"], "class": "technical-constraint", "governedBy": "platform.runtime",
    "why": "the two built-in modules whose availability sets the runtime floor; each is a capability of the runtime item with the release it arrived in" },
  { "id": "TA-10", "detector": "module", "tokens": ["fs", "path", "os", "crypto", "child_process", "net", "tls", "http", "https", "zlib", "stream/promises", "events", "dns", "async_hooks", "assert"], "files": ["**"], "class": "technical-constraint", "governedBy": "platform.runtime",
    "why": "core modules every release at or above the floor provides; a module not listed here is a new assumption the gate reports" },
  { "id": "TA-11", "detector": "module", "tokens": ["bull", "prom-client"], "files": ["lib/queue.js", "lib/metrics.js"], "class": "adapter", "governedBy": "build.libraries",
    "why": "the optional queue and metrics adapters; each is loaded only when configured and resolved through package-lock.json" },
  { "id": "TA-12", "detector": "module", "tokens": ["jsdom"], "files": ["test/*.js"], "class": "generated-resolution", "governedBy": "build.libraries",
    "why": "the development DOM the console suites drive; a devDependency resolved through package-lock.json" },
  { "id": "TA-13", "detector": "runtime-introspection", "tokens": ["process.versions.node", "process.version"], "files": ["server.js", "lib/api.js", "scripts/money-perf.js"], "class": "diagnostic",
    "why": "names the runtime in a message or a status report; decides nothing (the boot guard probes for node:sqlite instead of comparing version numbers)" },
  { "id": "TA-14", "detector": "runtime-introspection", "tokens": ["process.versions.node", "process.versions"], "files": ["scripts/technology.js", "test/technology.js"], "class": "consumes-resolution", "governedBy": "ci.test",
    "why": "verify-runtime compares the running runtime with the release the lock resolved for the lane" },
  { "id": "TA-15", "detector": "url-scheme", "tokens": ["http", "https"], "files": ["**"], "class": "technical-constraint",
    "why": "the web's own protocols, which the platform serves and calls" },
  { "id": "TA-16", "detector": "url-scheme", "tokens": ["postgres"], "files": ["lib/db.js", "lib/pg.js", "lib/api.js", "scripts/pg-check.js", "lib/connect.js", "lib/config.js", "lib/sql.js"], "class": "adapter", "governedBy": "platform.database",
    "why": "the PostgreSQL adapter (lib/pg.js speaks the wire protocol; SQLite through node:sqlite is the default engine)" },
  { "id": "TA-17", "detector": "url-scheme", "tokens": ["redis"], "files": ["lib/queue.js", "lib/config.js", "lib/connect.js", "lib/api.js"], "class": "adapter",
    "why": "the optional Redis queue adapter" },
  { "id": "TA-18", "detector": "url-scheme", "tokens": ["otpauth", "scheme"], "files": ["lib/identity.js", "lib/authz.js", "lib/api.js", "lib/webauthn.js", "lib/connect.js", "lib/config.js"], "class": "technical-constraint",
    "why": "the authenticator key URI format (otpauth://) and a placeholder in a message; not runtime technology" },
  { "id": "TA-19", "detector": "host-binary", "tokens": ["/usr/bin/node"], "files": ["systemd/luxora.service", "systemd/luxora-backup.service"], "class": "unverified-assumption", "governedBy": "platform.runtime",
    "why": "the systemd units run the host's runtime; nothing checks that it is a resolved release (the boot guard still refuses one without node:sqlite)" },
  { "id": "TA-20", "detector": "host-binary", "tokens": ["/usr/bin/env", "/bin/bash", "/usr/bin/env bash", "bash"], "files": ["*.sh"], "class": "technical-constraint",
    "why": "the convenience scripts' shell" },
  { "id": "TA-21", "detector": "browser-binary", "tokens": ["google-chrome", "google-chrome-stable", "chromium", "chromium-browser", "Google Chrome.app", "Chromium.app"], "files": ["scripts/browser-check.js", "test/*.js", ".github/workflows/ci.yml"], "class": "unverified-assumption", "governedBy": "ci.runner",
    "why": "the real-browser checks find Chrome or Chromium where the host put it (CHROME_PATH overrides); the CI runner image provides it unpinned, and the browser job now prints its version as evidence" }
 ]
}
