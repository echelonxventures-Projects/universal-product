    { "code": "LUNAR_TOKEN", "name": "Lunar Tokens", "symbol": "LT", "class": "colonial", "decimals": 0, "usd": 0, "settleable": false },
    { "code": "FED_CREDIT", "name": "Federation Credits", "symbol": "FC", "class": "federation", "decimals": 2, "usd": 0, "settleable": false },
    { "code": "CARBON", "name": "Carbon Credits", "symbol": "tCO₂e", "class": "environmental", "decimals": 3, "usd": 0, "settleable": true },
    { "code": "ENERGY", "name": "Energy Credits", "symbol": "kWh", "class": "utility", "decimals": 3, "usd": 0, "settleable": true },
    { "code": "RESOURCE", "name": "Resource Units", "symbol": "RU", "class": "commodity", "decimals": 3, "usd": 0, "settleable": true },
