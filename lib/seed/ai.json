 "CLEAN_RULES": [
  {
   "key": "title_trim",
   "field": "title",
   "op": "trim",
   "label": "Trim whitespace in titles"
  },
  {
   "key": "title_len",
   "field": "title",
   "op": "maxlen",
   "value": 90,
   "label": "Flag titles over 90 chars"
  },
  {
   "key": "brand_missing",
   "field": "brand",
   "op": "required",
   "label": "Missing brand"
  },
  {
   "key": "price_positive",
   "field": "price",
   "op": "positive",
   "label": "Price must be > 0"
  },
  {
   "key": "gtin_missing",
   "field": "identity",
   "op": "json_required",
