{
 "$comment": "What the platform keeps as records on the kernel, and what each console screen of the master shows (lib/master-view.js). A kind that extends the record kind is a register any platform can be configured to keep; a screen names the master's own kind, vocabulary, entity, registry or screen that already answers it, so nothing is described twice. A screen marked planned is declared and not built.",
 "namespace": "platform",
 "actor": "master-view",
 "recordKind": "master.record",
 "step": "records",
 "page": 200,
 "events": 50,
 "kinds": [
  { "kind": "master.record", "owner": "Registry", "label": "Record", "root": true, "parents": ["*"], "schemes": [], "attributes": [ { "key": "name", "type": "text", "required": true, "label": "Name" }, { "key": "description", "type": "text", "label": "Description" } ] },
  { "kind": "party.organisation", "owner": "Party", "extends": "master.record", "label": "Organisation", "attributes": [ { "key": "contact", "type": "text", "label": "Contact" }, { "key": "website", "type": "text", "label": "Website" } ] },
  { "kind": "party.account", "owner": "Party", "extends": "master.record", "label": "Account", "attributes": [ { "key": "organisation", "type": "node", "label": "Organisation", "constraints": { "nodeKind": "party.organisation" } } ] },
  { "kind": "party.activity", "owner": "Party", "extends": "master.record", "label": "Activity", "attributes": [ { "key": "account", "type": "node", "label": "Account", "constraints": { "nodeKind": "party.account" } }, { "key": "at", "type": "instant", "label": "When" } ] },
  { "kind": "party.network", "owner": "Party", "extends": "master.record", "label": "Business network", "attributes": [] },
  { "kind": "party.workspace", "owner": "Party", "extends": "master.record", "label": "Workspace", "attributes": [] },
  { "kind": "operations.maintenance", "owner": "Operations", "extends": "master.record", "label": "Maintenance", "attributes": [ { "key": "due", "type": "instant", "label": "Due" } ] },
  { "kind": "operations.slo", "owner": "Operations", "extends": "master.record", "label": "Service level objective", "attributes": [ { "key": "target", "type": "number", "label": "Target (%)", "constraints": { "min": 0, "max": 100 } } ] },
  { "kind": "experience.website", "owner": "Experience", "extends": "master.record", "label": "Website", "attributes": [ { "key": "address", "type": "text", "label": "Address" } ] },
  { "kind": "experience.mobile_app", "owner": "Experience", "extends": "master.record", "label": "Mobile app", "attributes": [ { "key": "address", "type": "text", "label": "Address" } ] },
  { "kind": "experience.portal", "owner": "Experience", "extends": "master.record", "label": "Portal", "attributes": [ { "key": "address", "type": "text", "label": "Address" } ] },
  { "kind": "experience.component", "owner": "Experience", "extends": "master.record", "label": "Interface component", "attributes": [] },
  { "kind": "experience.journey", "owner": "Experience", "extends": "master.record", "label": "Experience journey", "attributes": [ { "key": "steps", "type": "list", "label": "Steps" } ] },
  { "kind": "experience.customer_journey", "owner": "Experience", "extends": "experience.journey", "label": "Customer journey", "attributes": [] },
  { "kind": "agent.team", "owner": "Agent", "extends": "master.record", "label": "Agent team", "attributes": [] }
 ],
 "hierarchies": [
  { "hierarchy": "party.roles", "owner": "Relationship", "label": "The role each party plays" },
  { "hierarchy": "party.members", "owner": "Relationship", "label": "Who belongs to a network, a workspace or a team" }
 ],
 "screens": {
  "region": { "entity": "subdivision" },
  "product_family": { "kind": "master.family" },
  "product_type": { "vocabulary": "vocab.item_kinds" },
  "service_type": { "vocabulary": "vocab.item_kinds", "where": { "base": "master.service" } },
  "specification": { "kind": "master.attribute" },
  "vendor": { "entity": "seller" },
  "media": { "vocabulary": "vocab.media_kinds" },
  "buyer": { "entity": "customer" },
  "partner": { "kind": "party.organisation", "hierarchy": "party.roles", "under": "vocab.party_roles.partner" },
  "distributor": { "kind": "party.organisation", "hierarchy": "party.roles", "under": "vocab.party_roles.distributor" },
  "dealer": { "kind": "party.organisation", "hierarchy": "party.roles", "under": "vocab.party_roles.dealer" },
  "franchise": { "kind": "party.organisation", "hierarchy": "party.roles", "under": "vocab.party_roles.franchise" },
  "crm_account": { "kind": "party.account" },
  "activity": { "kind": "party.activity" },
  "agreement": { "entity": "contract" },
  "relationship": { "registry": "hierarchies" },
  "business_network": { "kind": "party.network" },
  "referral": { "view": "goffers" },
