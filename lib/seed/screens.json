  "governance_graph": { "view": "domains" },
  "capability_registry": { "view": "capabilities" },
  "extension": { "view": "modules" },
  "reliability": { "view": "monitor" },
  "performance": { "view": "monitor" },
  "slo": { "kind": "operations.slo" },
  "workspace": { "kind": "party.workspace" },
  "license": { "kind": "master.license" },
  "configuration": { "registry": "settings" },
  "canonical_object": { "registry": "kinds" },
  "canonical_schema": { "view": "definitions" },
  "canonical_relationship": { "registry": "hierarchies" },
  "canonical_event": { "registry": "events" },
  "canonical_workflow": { "registry": "machines" },
  "canonical_api": { "view": "ucii" },
  "capability_graph": { "view": "capability-tree" },
  "dependency_graph": { "view": "trace" },
  "traceability_graph": { "view": "trace" },
  "reference_architecture": { "view": "architecture" },
  "security_architecture": { "view": "architecture" },
  "data_architecture": { "view": "architecture" },
  "ai_architecture": { "view": "architecture" },
  "personalization_engine": { "planned": "Insight" },
