{
  "$comment": "The kernel's own declarations (FOUNDATIONS K01–K12), read by lib/kernel.js, lib/kernel-shape.js, lib/kernel-context.js and lib/kernel-lifecycle.js. Data, not code: a namespace or an event name added here needs no code change; a value type, a shape type, an attribute constraint or a view grouping also needs its check in code (TYPE_CHECKS, CONTAINS, CONSTRAINTS, GROUPINGS), and an operation its call in lib/kernel-lifecycle.js OPS.",
  "namespaces": [
    "platform",
    "tenant",
    "publisher"
  ],
  "defaultNamespace": "platform",
  "valueTypes": [
    {
      "key": "text",
      "label": "Text"
    },
    {
      "key": "number",
      "label": "Number"
    },
    {
      "key": "integer",
      "label": "Whole number"
    },
    {
      "key": "boolean",
      "label": "Yes or no"
    },
    {
      "key": "instant",
      "label": "Point in time (ISO 8601)"
    },
    {
      "key": "node",
      "label": "Reference to another node"
    },
    {
      "key": "list",
      "label": "List of values"
    },
    {
      "key": "record",
      "label": "Structured value"
    },
    {
      "key": "expression",
      "label": "Text in any number of languages: { <language>: <text> }",
      "localised": true
    },
    {
      "key": "quantity",
      "label": "An amount in a unit: { amount, unit } where the unit is a node"
    }
  ],
  "identity": {
    "scheme": "uid",
    "label": "Universal ID",
    "declaredBy": "identifier.scheme"
  },
  "events": {
    "kindDefined": "kernel.kind.defined",
    "nodeCreated": "kernel.node.created",
    "attributesRecorded": "kernel.attributes.recorded",
    "identifierAssigned": "kernel.identifier.assigned",
    "identifierEnded": "kernel.identifier.ended",
    "hierarchyDefined": "kernel.hierarchy.defined",
    "nodePlaced": "kernel.node.placed",
    "placementEnded": "kernel.placement.ended",
    "coordinateSystemDefined": "kernel.coordinate-system.defined",
    "shapeRecorded": "kernel.shape.recorded",
    "settingDeclared": "kernel.setting.declared",
    "valueAssigned": "kernel.value.assigned",
    "resolutionDefined": "kernel.resolution.defined",
    "viewDefined": "kernel.view.defined",
    "changeDrafted": "kernel.change.drafted",
    "changeEdited": "kernel.change.edited",
    "changeMoved": "kernel.change.moved",
    "changeRolledBack": "kernel.change.rolled-back",
    "nodeStateChanged": "kernel.node.state-changed",
    "nodePurged": "kernel.node.purged"
  },
  "limits": {
    "keyPattern": "^[a-z][a-z0-9_.-]{0,63}$",
    "holderPattern": "^[a-z0-9][a-z0-9_.-]{0,63}$",
    "maxDepth": 4096,
    "eventPage": 500,
    "maxExtends": 64
  },
  "shapeTypes": [
    {
      "key": "point",
      "label": "A point"
    },
    {
      "key": "box",
      "label": "A box: a minimum and maximum on every axis"
    },
    {
      "key": "ball",
      "label": "A ball: a centre and a radius"
    },
    {
      "key": "polygon",
      "label": "A polygon on the first two axes"
    }
  ],
  "lifecycle": {
    "initial": "draft",
    "validated": "validated",
    "approved": "approved",
    "scheduled": "scheduled",
    "published": "published",
    "rolledBack": "rolled-back",
    "discarded": "discarded",
    "untitled": "Untitled change",
    "transitions": {
      "draft": [
        "validated",
        "discarded"
      ],
      "validated": [
        "approved",
        "discarded"
      ],
      "approved": [
        "scheduled",
        "published",
        "discarded"
      ],
      "scheduled": [
        "published",
        "discarded"
      ],
      "published": [
        "rolled-back"
      ],
      "rolled-back": [],
      "discarded": []
    },
    "distinctApprover": true,
    "operations": [
      "defineKind",
      "createNode",
      "record",
      "assignIdentifier",
      "endIdentifier",
      "defineHierarchy",
      "place",
      "endPlacement",
      "defineSystem",
      "setShape",
      "declareSetting",
      "assign",
      "defineResolution",
      "defineView"
    ],
    "nodeStates": {
      "initial": "active",
      "hidden": "hidden",
      "archived": "archived",
      "transitions": {
        "active": [
          "hidden",
          "archived"
        ],
        "hidden": [
          "active",
          "archived"
        ],
        "archived": [
          "active"
        ]
      },
      "listed": [
        "active"
      ]
    },
    "purgePermission": "kernel.purge",
    "approvePermission": "kernel.approve"
  },
  "constraints": [
    {
      "key": "min",
      "label": "At least",
      "types": [
        "number",
        "integer"
      ],
      "param": "number"
    },
    {
      "key": "max",
      "label": "At most",
      "types": [
        "number",
        "integer"
      ],
      "param": "number"
    },
    {
      "key": "minLength",
      "label": "At least this many characters or items",
      "types": [
        "text",
        "list"
      ],
      "param": "integer"
    },
    {
      "key": "maxLength",
      "label": "At most this many characters or items",
      "types": [
        "text",
        "list"
      ],
      "param": "integer"
    },
    {
      "key": "pattern",
      "label": "Matches a regular expression",
      "types": [
        "text"
      ],
      "param": "pattern"
    },
    {
      "key": "oneOf",
      "label": "One of a declared list",
      "types": [
        "text",
        "number",
        "integer"
      ],
      "param": "list"
    },
    {
      "key": "nodeKind",
      "label": "Refers to a node of a kind (or a kind extending it)",
      "types": [
        "node",
        "quantity"
      ],
      "param": "key"
    },
    {
      "key": "unique",
      "label": "No other node of the kind holds the same value",
      "types": [
        "text",
        "number",
        "integer"
      ],
      "param": "boolean",
      "needsNode": true
    },
    {
      "key": "languages",
      "label": "Carries text in each of these languages",
      "types": [
        "expression"
      ],
      "param": "list"
    }
  ],
  "groupings": [
    {
      "key": "kind",
      "label": "By kind",
      "params": {}
    },
    {
      "key": "attribute",
      "label": "By an attribute value",
      "params": {
        "key": "key"
      }
    },
    {
      "key": "ancestor",
      "label": "By the nearest ancestor of a kind in a hierarchy",
      "params": {
        "hierarchy": "hierarchy",
        "kind": "key"
      }
    }
  ],
  "checkRules": [
    {
      "key": "gs1",
      "label": "GS1 modulo 10"
    },
    {
      "key": "luhn",
      "label": "Luhn modulo 10"
    },
    {
      "key": "isbn",
      "label": "ISBN-10 modulo 11 or ISBN-13 (GS1)"
    },
    {
      "key": "issn",
      "label": "ISSN modulo 11"
    },
    {
      "key": "cas",
      "label": "CAS registry number check digit"
    }
  ]
}
