{
  "$comment": "The kernel's own declarations (FOUNDATIONS K01–K12), read by lib/kernel.js, lib/kernel-shape.js, lib/kernel-context.js and lib/kernel-lifecycle.js. Data, not code: a namespace or an event name added here needs no code change; a value type or a shape type also needs its check in code (TYPE_CHECKS, CONTAINS), and an operation its call in lib/kernel-lifecycle.js OPS.",
  "namespaces": [
    "platform",
    "tenant",
    "publisher"
  ],
  "defaultNamespace": "platform",
  "valueTypes": [
    {
      "key": "text",
      "label": "Text"
    },
    {
      "key": "number",
      "label": "Number"
    },
    {
      "key": "integer",
      "label": "Whole number"
    },
    {
      "key": "boolean",
      "label": "Yes or no"
    },
    {
      "key": "instant",
      "label": "Point in time (ISO 8601)"
    },
    {
      "key": "node",
      "label": "Reference to another node"
    },
    {
      "key": "list",
      "label": "List of values"
    },
    {
      "key": "record",
      "label": "Structured value"
    }
  ],
  "identity": {
    "scheme": "uid",
    "label": "Universal ID"
  },
  "events": {
    "kindDefined": "kernel.kind.defined",
    "nodeCreated": "kernel.node.created",
    "attributesRecorded": "kernel.attributes.recorded",
    "identifierAssigned": "kernel.identifier.assigned",
    "identifierEnded": "kernel.identifier.ended",
    "hierarchyDefined": "kernel.hierarchy.defined",
    "nodePlaced": "kernel.node.placed",
    "placementEnded": "kernel.placement.ended",
    "coordinateSystemDefined": "kernel.coordinate-system.defined",
    "shapeRecorded": "kernel.shape.recorded",
    "settingDeclared": "kernel.setting.declared",
    "valueAssigned": "kernel.value.assigned",
    "resolutionDefined": "kernel.resolution.defined",
    "viewDefined": "kernel.view.defined",
    "changeDrafted": "kernel.change.drafted",
    "changeEdited": "kernel.change.edited",
    "changeMoved": "kernel.change.moved",
    "changeRolledBack": "kernel.change.rolled-back",
    "nodeStateChanged": "kernel.node.state-changed",
    "nodePurged": "kernel.node.purged"
  },
  "limits": {
    "keyPattern": "^[a-z][a-z0-9_.-]{0,63}$",
    "maxDepth": 4096,
    "eventPage": 500
  },
  "shapeTypes": [
    {
      "key": "point",
      "label": "A point"
    },
    {
      "key": "box",
      "label": "A box: a minimum and maximum on every axis"
    },
    {
      "key": "ball",
      "label": "A ball: a centre and a radius"
    },
    {
      "key": "polygon",
      "label": "A polygon on the first two axes"
    }
  ],
  "lifecycle": {
    "initial": "draft",
    "validated": "validated",
    "approved": "approved",
    "scheduled": "scheduled",
    "published": "published",
    "rolledBack": "rolled-back",
    "discarded": "discarded",
    "untitled": "Untitled change",
    "transitions": {
      "draft": [
        "validated",
        "discarded"
      ],
      "validated": [
        "approved",
        "discarded"
      ],
      "approved": [
        "scheduled",
        "published",
        "discarded"
      ],
      "scheduled": [
        "published",
        "discarded"
      ],
      "published": [
        "rolled-back"
      ],
      "rolled-back": [],
      "discarded": []
    },
    "distinctApprover": true,
    "operations": [
      "defineKind",
      "createNode",
      "record",
      "assignIdentifier",
      "endIdentifier",
      "defineHierarchy",
      "place",
      "endPlacement",
      "defineSystem",
      "setShape",
      "declareSetting",
      "assign",
      "defineResolution",
      "defineView"
    ],
    "nodeStates": {
      "initial": "active",
      "hidden": "hidden",
      "archived": "archived",
      "transitions": {
        "active": [
          "hidden",
          "archived"
        ],
        "hidden": [
          "active",
          "archived"
        ],
        "archived": [
          "active"
        ]
      }
    },
    "purgePermission": "kernel.purge"
  }
}
