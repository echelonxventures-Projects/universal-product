   },
   "on": {
    "*>approved": [
     {
      "set": {
       "po_status": "draft"
      }
     },
     {
      "run": "mint_po_ref"
     }
    ],
    "*>ordered": [
     {
      "set": {
       "po_status": "issued"
      }
     },
     {
      "run": "mint_po_ref"
     }
    ],
    "*>received": [
     {
      "set": {
       "po_status": "received"
      }
     }
    ],
    "*>skipped": [
     {
      "set": {
       "po_status": "skipped"
      }
     }
    ]
   }
  },
