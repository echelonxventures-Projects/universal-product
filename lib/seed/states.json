{
 "$comment": "Seed data for the state-machine kernel (lib/states.js). Becomes the stateMachines registry list on first boot and is edited in the console from then on. states/transitions may reference a registry list as list:<name>. Tags are what a state MEANS to the engines (they ask by tag, never by name); stamps are time columns written on entering a state; 'on' declares per-move guards and effects: set, stamp, run <handler>, guard <handler>.",
 "stateMachines": [
  {
   "key": "order",
   "name": "Order",
   "column": "status",
   "initial": "processing",
   "free": true,
   "states": [
    "pending_payment",
    "processing",
    "shipped",
    "delivered",
    "cancelled",
    "refunded"
   ],
   "meta": {
    "pending_payment": {
     "tags": [
      "awaiting_payment"
     ]
    },
    "processing": {
     "tags": [
      "open",
      "fulfilment"
     ]
    },
    "shipped": {
     "tags": [
      "open",
      "fulfilment",
      "in_transit"
     ]
    },
    "delivered": {
     "tags": [
      "fulfilled",
      "success",
      "fulfilment"
     ]
    },
    "cancelled": {
     "tags": [
      "terminal",
      "failure",
      "void"
     ]
    },
    "refunded": {
     "tags": [
      "terminal",
      "void"
     ]
    }
   }
  },
  {
   "key": "ride",
   "name": "Ride",
   "column": "status",
   "initial": "requested",
   "states": "list:mobilityRideStatuses",
   "transitions": "list:mobilityTransitions",
   "meta": {
    "accepted": {
     "tags": [
      "open",
      "active",
      "assigned"
     ],
     "stamps": [
      "accepted_at"
     ]
    },
    "arrived": {
     "tags": [
      "active"
     ],
     "stamps": [
      "arrived_at"
     ]
    },
    "trip_start": {
     "tags": [
      "active",
      "in_progress"
     ],
     "stamps": [
      "started_at"
     ]
    },
    "completed": {
     "tags": [
      "terminal",
      "success",
      "rateable",
      "billable"
     ],
     "stamps": [
      "completed_at"
     ]
    },
    "cancelled": {
     "tags": [
      "terminal",
      "failure",
      "billable"
     ],
     "stamps": [
      "cancelled_at"
     ]
    },
    "requested": {
     "tags": [
      "open",
      "active"
     ]
    }
   },
   "on": {
    "*>completed": [
     {
      "run": "settle_fare"
     }
    ],
    "*>cancelled": [
     {
      "run": "release_driver"
     }
    ],
    "trip_start>cancelled": [
     {
      "run": "cancel_fee",
      "param": "cancel_fee_midtrip"
     }
    ],
    "accepted>cancelled": [
     {
      "run": "cancel_fee",
      "param": "cancel_fee_accepted"
     }
    ]
   }
  },
  {
   "key": "driver",
   "name": "Driver",
   "column": "status",
   "initial": "offline",
   "free": true,
   "states": [
    "offline",
    "online",
    "busy",
    "suspended"
   ],
   "meta": {
    "offline": {
     "tags": [
      "off"
     ]
    },
    "online": {
     "tags": [
      "available",
      "online"
     ]
    },
    "busy": {
     "tags": [
      "engaged",
      "online"
     ]
    },
    "suspended": {
     "tags": [
      "blocked"
     ]
    }
   }
  },
  {
   "key": "vehicle",
   "name": "Vehicle",
   "column": "status",
   "initial": "active",
   "free": true,
   "states": [
    "active",
    "maintenance",
    "retired"
   ],
   "meta": {
    "retired": {
     "tags": [
      "terminal"
     ]
    }
   }
  },
  {
   "key": "purchase_request",
   "name": "Purchase request",
   "column": "status",
   "initial": "draft",
   "states": "list:opsPrStatuses",
   "transitions": {
    "draft": [
     "submitted"
    ],
    "submitted": [
     "approved"
    ],
    "approved": [
     "ordered"
    ],
    "ordered": [
     "received"
    ]
   },
   "meta": {
    "approved": {
     "tags": [
      "approved"
     ],
     "stamps": [
      "approved_at"
     ]
    },
    "received": {
     "tags": [
      "terminal",
      "success"
     ]
    },
    "rejected": {
     "tags": [
      "terminal",
      "failure"
     ]
    },
    "draft": {
     "tags": [
      "creatable"
     ]
    },
    "submitted": {
     "tags": [
      "creatable"
     ]
    }
   },
   "on": {
    "*>approved": [
     {
      "guard": "approval_threshold"
     },
     {
      "run": "record_approver"
     }
    ]
   }
  },
  {
   "key": "approval",
   "name": "Approval",
   "column": "status",
   "initial": "pending",
   "free": true,
   "states": [
    "pending",
    "approved",
    "rejected"
   ],
   "meta": {
    "approved": {
     "tags": [
      "decision",
      "granted"
     ],
     "stamps": [
      "decided_at"
     ]
    },
    "rejected": {
     "tags": [
      "decision",
      "refused"
     ],
     "stamps": [
      "decided_at"
     ]
    }
   }
  },
  {
   "key": "payroll_run",
   "name": "Payroll run",
   "column": "status",
   "initial": "draft",
   "free": true,
   "states": [
    "draft",
    "approved",
    "paid"
   ],
   "meta": {
    "approved": {
     "stamps": [
      "approved_at"
     ]
    },
    "paid": {
     "tags": [
      "terminal",
      "success"
     ],
     "stamps": [
      "paid_at",
      {
       "col": "approved_at",
       "once": true
      }
     ]
    }
   },
   "on": {
    "*>paid": [
     {
      "run": "pay_lines"
     }
    ]
   }
  },
  {
   "key": "payroll_line",
