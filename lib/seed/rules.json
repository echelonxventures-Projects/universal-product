{
 "$comment": "Seed data for the applicability rules (lib/rules.js). Each top-level key becomes a registry list (meta_lists) on first boot and is edited in the console from then on; lib/rules.js reads the registry, never this file at decision time. Sources (subject types, dimension options) use one grammar: list:<registry list> · rows:<table>:<id col>:<label col>[:<col>=<value>] · values:<table>:<json col>[.<path>][:<col>=<value>] · entity:<Data Studio entity>, joined with '+'.",
 "ruleSubjectTypes": [
  {
   "key": "gateway",
   "name": "Payment gateway",
   "source": "rows:provider_defs:id:name:kind=payment",
   "params": {
    "fee_pct": "feePct",
    "fee_fixed": "feeFixed",
    "label": "name"
   }
  },
  {
   "key": "method",
   "name": "Payment method",
   "source": "list:paymentMethods+list:offlinePaymentMethods+values:provider_defs:methods:kind=payment"
  },
  {
   "key": "bank",
   "name": "Bank",
   "source": "list:banks"
  },
  {
   "key": "carrier",
   "name": "Shipping carrier",
   "source": "rows:provider_defs:id:name:kind=shipping",
   "params": {
    "base_fee": "baseFee",
    "free_over": "freeOver",
    "eta": "eta",
    "label": "name"
   }
  },
  {
   "key": "notifier",
   "name": "Notification channel",
   "source": "rows:provider_defs:id:name:kind=notification"
  },
  {
   "key": "marketing",
   "name": "Marketing integration",
   "source": "rows:provider_defs:id:name:kind=marketing"
  },
  {
   "key": "ai",
   "name": "AI provider",
   "source": "rows:provider_defs:id:name:kind=ai"
  },
  {
   "key": "capability",
   "name": "Capability",
   "source": "rows:platform_capabilities:key:label"
  },
  {
   "key": "module",
   "name": "Module capability",
   "source": "values:modules:manifest.capabilities"
  },
  {
   "key": "service",
   "name": "Service",
   "source": "list:services"
  },
  {
   "key": "ai_capability",
   "name": "AI capability",
   "source": "list:aiCapabilities"
  },
  {
   "key": "ai_model",
   "name": "AI model",
   "source": "list:aiModels"
  },
  {
   "key": "promotion",
   "name": "Promotion",
   "source": "entity:promotion"
  },
  {
   "key": "offer",
   "name": "Offer / exchange",
   "source": "rows:offers:id:name"
  },
  {
   "key": "coupon",
   "name": "Coupon code",
   "source": "rows:coupons:code:code"
  },
  {
   "key": "login_method",
   "name": "Sign-in method",
   "source": "list:identityProviderTypes"
  }
 ],
 "ruleDimensions": [
  {
   "key": "kinds",
   "name": "Platform kinds",
   "fact": "kind",
   "match": "in",
   "source": "platform",
   "column": "mode",
   "options": "list:deployModes"
  },
  {
   "key": "platforms",
   "name": "Platforms",
   "fact": "platform",
   "match": "in",
   "source": "platform",
   "column": "slug",
   "options": "rows:tenants:slug:name"
  },
  {
   "key": "countries",
   "name": "Countries or groups",
   "fact": "country",
   "match": "group",
   "groups": "countryGroups",
   "source": "platform",
   "column": "country",
   "overridable": true,
   "upper": true,
   "options": "list:countryGroups+rows:countries:code:name",
   "setting": "commerce.country"
  },
  {
   "key": "regions",
   "name": "States / regions",
   "fact": "region",
   "match": "prefix",
   "source": "request",
   "upper": true,
   "options": ""
  },
  {
   "key": "currencies",
   "name": "Currencies",
   "fact": "currency",
   "match": "in",
   "source": "platform",
   "derive": {
    "table": "countries",
    "key": "code",
    "value": "currency",
    "from": "country"
   },
   "overridable": true,
   "upper": true,
   "options": "rows:currencies:code:name",
   "setting": "commerce.currency"
  },
  {
   "key": "services",
   "name": "Services",
   "fact": "service",
   "match": "in",
   "source": "binding",
   "options": "list:services"
  },
  {
   "key": "segments",
   "name": "Customer segments",
   "fact": "segments",
   "match": "any",
   "source": "computed",
   "provider": "segments",
   "options": "list:segments+list:goipAudiences"
  },
  {
   "key": "channels",
   "name": "Channels",
   "fact": "channel",
   "match": "in",
   "source": "request",
   "header": "x-channel",
   "default": "first",
   "options": "list:channels"
  }
 ],
 "ruleBindings": [
  {
   "key": "checkout.service",
