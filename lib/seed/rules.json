   "key": "login.password",
   "name": "Sign-in — email / password",
   "subject_type": "login_method",
   "subject": "password",
   "exemptRoles": [
    "admin"
   ]
  },
  {
   "key": "fintech.upi_collect",
   "name": "UPI collect",
   "checks": [
    {
     "type": "service",
     "value": "upi_collect"
    },
    {
     "type": "method",
     "value": "upi"
    }
   ],
   "facts": {
    "service": "upi_collect"
   },
   "inputs": {
    "amount": "amount",
    "currency": "currency"
   }
  },
  {
   "key": "fintech.payment_link",
   "name": "Payment links",
   "checks": [
    {
     "type": "service",
     "value": "payment_link"
    },
    {
     "type": "gateway",
     "from": "gateway"
    }
   ],
   "facts": {
    "service": "payment_link"
   },
   "inputs": {
    "amount": "amount",
    "currency": "currency"
   }
  },
  {
   "key": "fintech.mandate",
   "name": "Recurring mandates",
   "checks": [
    {
     "type": "service",
     "value": "mandate"
    },
    {
     "type": "gateway",
     "from": "gateway"
    },
    {
     "type": "bank",
     "resolve": "bank"
    }
