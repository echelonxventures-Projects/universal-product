 "ENGINES": [
  {
   "key": "context_resolution",
   "name": "Context Resolution Engine",
   "owns": "fills all 25 context dimensions",
   "impl": "goip.resolveContext"
  },
  {
   "key": "eligibility",
   "name": "Eligibility Engine",
   "owns": "is this exchange permitted in this context",
   "impl": "goip.eligibility"
  },
  {
   "key": "qualification",
   "name": "Qualification Engine",
   "owns": "declared conditions over the resolved context",
   "impl": "goip.qualify"
  },
  {
   "key": "decision",
   "name": "Decision Engine",
   "owns": "which qualified exchanges actually execute",
   "impl": "offers.evaluate + goip hooks"
  },
  {
   "key": "discovery",
   "name": "Offer Discovery Engine",
   "owns": "what is available to this subject now",
   "impl": "goip.discover"
  },
  {
   "key": "benefit_resolution",
   "name": "Benefit Resolution Engine",
   "owns": "benefit → concrete units",
   "impl": "offers.HANDLERS (+GOIP handlers)"
  },
  {
   "key": "conflict_resolution",
   "name": "Conflict Resolution Engine",
   "owns": "same-domain collisions",
   "impl": "goip.resolveConflicts"
  },
  {
   "key": "stacking",
   "name": "Stacking Engine",
   "owns": "stack groups / exclusivity / max count",
   "impl": "offers.evaluate"
  },
  {
   "key": "ranking",
   "name": "Ranking Engine",
   "owns": "order candidates by objective",
   "impl": "goip.rank"
  },
  {
   "key": "optimization",
   "name": "Optimization Engine",
   "owns": "parameter proposals against an objective",
   "impl": "goip.optimize"
  },
  {
   "key": "recommendation",
   "name": "Recommendation Engine",
   "owns": "best next exchange for a subject",
   "impl": "goip.recommend"
  },
  {
   "key": "personalization",
   "name": "Personalization Engine",
   "owns": "subject segments + behaviour",
   "impl": "goip.personalize"
  },
  {
   "key": "pricing",
   "name": "Pricing Engine",
   "owns": "net price after value exchange",
   "impl": "goip.price"
  },
  {
   "key": "simulation",
   "name": "Simulation Engine",
   "owns": "what-if over real or synthetic carts",
   "impl": "goip.simulate"
  },
  {
   "key": "forecasting",
   "name": "Forecasting Engine",
   "owns": "burn / liability projection",
   "impl": "goip.forecast"
  },
  {
   "key": "fraud",
   "name": "Fraud Engine",
   "owns": "abuse signals per subject/instrument",
   "impl": "goip.fraudScore"
  },
  {
   "key": "risk",
   "name": "Risk Engine",
   "owns": "exposure of an instrument",
   "impl": "goip.riskScore"
  },
  {
   "key": "governance",
   "name": "Governance Engine",
   "owns": "policy, approval, lifecycle, version, audit",
   "impl": "goip.govern"
  }
