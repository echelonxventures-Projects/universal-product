[Unit]
Description=LUXORA database backup (encrypted; the keyring is never included)
After=luxora.service

[Service]
Type=oneshot
User=www-data
WorkingDirectory=/var/www/luxora
# Must point at the same database the server uses (LX_DB) when it is not data/luxora.db.
# Keep 14 nightly sets locally; copy each off the machine as well. A backup on the same disk
# is not a backup.
Environment="LX_BACKUP_DIR=/var/www/luxora/data/backups"
Environment="LX_BACKUP_KEEP=14"
# Secrets live in a root-owned 0600 file, not in this unit:
#   LX_BACKUP_PASSPHRASE=...        encrypts every set (required for an off-host upload)
#   LX_BACKUP_S3_BUCKET=... LX_BACKUP_S3_ACCESS=... LX_BACKUP_S3_SECRET=...
#   (+ LX_BACKUP_S3_REGION / LX_BACKUP_S3_ENDPOINT for R2, MinIO, B2)
# The keyring (data/master.json) and seal key (data/registry.json) are NOT in the backup:
# keep them in a separate secret store (DATABASE_RECOVERY_RUNBOOK.md).
EnvironmentFile=-/etc/luxora/backup.env
ExecStart=/usr/bin/node scripts/backup.js
StandardOutput=journal
StandardError=journal
