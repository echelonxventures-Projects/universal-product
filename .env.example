# Copy to .env and replace every placeholder before a production deployment.
NODE_ENV=production
PORT=3000

# Required on the first production boot. Use unique, long values.
PLATFORM_PASSWORD=replace-with-a-strong-platform-password
ADMIN_PASSWORD=replace-with-a-strong-store-password

# Keep these outside the repository. LUXORA_MASTER_KEY is exactly 64 hex characters.
LUXORA_MASTER_KEY=replace-with-64-hex-characters
LUXORA_PEPPER=replace-with-a-long-random-pepper

# Observability. (The public address is the store's domain, set in Platform console → Stores.)
LX_METRICS_TOKEN=replace-with-a-long-random-metrics-token
LX_LOG=json

# Set when the application is behind a trusted reverse proxy.
LX_TRUST_PROXY=1

# SQLite is the default. For Postgres, set LX_DB_DRIVER=postgres and LX_PG_URL.
# LX_DB=data/luxora.db
# LX_DB_DRIVER=sqlite
# LX_PG_URL=postgres://user:password@db.example/luxora

# Optional transport configuration.
# Email and SMS senders are set in Store console → Payments → Email & SMS senders.

# Use HTTPS directly only when this process owns TLS; otherwise terminate TLS at the proxy.
# LUX_TLS=1
# LUX_TLS_KEY=/run/secrets/luxora-tls-key.pem
# LUX_TLS_CERT=/run/secrets/luxora-tls-cert.pem

# ── Cache ──────────────────────────────────────────────────────────────────────
# LX_CACHE=lru                    # lru (default) | redis
# REDIS_URL=redis://127.0.0.1:6379

# ── Queue & Background Jobs ────────────────────────────────────────────────────
# LX_QUEUE=lite                    # lite (default, file-based) | bull (Redis-backed)

# ── Connection Pool & DB ───────────────────────────────────────────────────────
# LX_PG_TIMEOUT=5000               # statement timeout in ms

# File storage (local / S3 / webhook), the outbound mode, the webhook hook and the rate-limit and
# session stores are set in Platform console → Runtime. A per-store request ceiling is a security
# policy setting (tenantPerMin; 0 = off), set in the platform console.

# ── Offline mode (development and tests) ───────────────────────────────────────
# LX_OFFLINE=0                     # 1 to run without external services (dev/test)
# Webhooks are always https, idempotency is always on, production never simulates a payment,
# and SMTP without TLS is allowed only to a relay on this machine — none of these is a switch.

# ── Registry & Idempotency ─────────────────────────────────────────────────────
# LX_REGISTRY_KEY=                 # shared key for registry push/auth
# LX_REGISTRY_STRICT=1             # 0 to allow unverified registry entries

# Brand name, currency, tax and every other store setting are set in Store console → Settings.

# ── Email & Notifications ──────────────────────────────────────────────────────
# PLATFORM_EMAIL=noreply@example.com
# ADMIN_EMAIL=admin@example.com

# ── Demo Seed Data ──────────────────────────────────────────────────────────────
# AURUM_ADMIN_PASSWORD=            # demo store admin password (aurum)
# VELORA_ADMIN_PASSWORD=           # demo store admin password (velora)
# DEMO_DEFAULT_PASSWORDS=          # comma-separated demo passwords
# LUXORA_DEMO_BRANDS=              # comma-separated demo brand names
# LUXORA_DEMO_HINT=                # hint shown on demo login screens
# In production a store starts with an empty shelf: no sample products, banners, universes,
# ratings or reviews. Set these only for a demonstration, never on a live store.
# LUXORA_DEMO_CATALOG=1           # sample products, home banners and the universe shelf
# LUXORA_DEMO_REVIEWS=1           # invented ratings and reviews on the sample products

