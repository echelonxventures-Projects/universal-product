# The build context must never carry local state into an image: data/ holds the local
# database(s), the keyring (data/master.json) and the registry seal — baking those into
# an image ships one machine's secrets to every container started from it.
data/
node_modules/
.git/
.github/
*.db
*.db-wal
*.db-shm
*.sqlite*
*.log
*.pid
.env
.env.*
test/
_superseded/
# compiled registry artifacts are machine-local (sealed with that machine's data/registry.json
# key); an image must compile and seal its own, or every boot fails verification
_registry/canonical.lxr
_registry/canonical.json
backups/
.workbuddy-ai/
.vscode/
.idea/
.DS_Store
