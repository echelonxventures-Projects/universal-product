{
 "note": "The reviewed classification of every REAL column (scripts/money-audit.js). class: money (an amount of a currency), unit_price (a monetary rate: a price per unit, per period, per second), exchange_rate, quantity, ratio (a percentage, rate or multiplier), measurement. scope: spine = migrated to exact minor units (lib/money-store.js, lib/seed/money.json); projection = written only from an exact ledger; input = a rate read exactly through lib/money.js (15 significant digits) where it is priced; domain = money outside the payment spine, still REAL (PRODUCTION_READINESS.md PR-045).",
 "spineModules": ["lib/money-store.js", "lib/refunds.js", "lib/tax.js", "lib/billing.js", "lib/fin.js", "lib/spec.js", "lib/connect.js", "lib/wallet.js", "lib/recurring.js"],
 "codeWords": {
  "money": ["price", "amount", "total", "fee", "tax", "subtotal", "sub\\b", "gross", "net\\b", "commission", "balance", "refund", "cost", "fare", "salary", "charge", "paid", "payout", "discount", "credit", "debit", "wallet", "money", "revenue", "spent", "budget", "premium", "principal", "emi\\b", "deposit", "earning", "ship", "gift", "deduction", "overtime", "minor", "cents", "gmv", "mrr", "aov", "invoice", "settle"],
  "measure": ["km", "lat\\b", "lng\\b", "kg", "oz\\b", "weight", "rating", "score", "ms\\b", "mb\\b", "kb\\b", "percent", "pct", "ratio", "secs", "seconds", "minutes", "hours", "days", "latency", "distance", "duration", "eta", "odometer", "bytes", "rss", "cpu", "progress", "width", "height", "px\\b", "zoom", "lift", "ctr", "uptime", "share", "conversion", "rate\\b"]
 },
 "columns": {
  "orders.sub": { "class": "money", "scope": "spine", "note": "goods after offers, in orders.currency; orders.sub_minor" },
  "orders.ship_fee": { "class": "money", "scope": "spine", "note": "orders.ship_fee_minor" },
  "orders.gift_used": { "class": "money", "scope": "spine", "note": "store credit spent; orders.gift_used_minor" },
  "orders.tax": { "class": "money", "scope": "spine", "note": "orders.tax_minor" },
  "orders.total": { "class": "money", "scope": "spine", "note": "what was charged; orders.total_minor" },
  "orders.fx": { "class": "exchange_rate", "scope": "input", "note": "base → shown currency rate the order was priced at" },
  "order_items.price": { "class": "unit_price", "scope": "spine", "note": "unit price shown, at the currency's scale; order_items.price_minor + currency" },
  "payments.amount": { "class": "money", "scope": "spine", "note": "payments.amount_minor; refunded_minor beside it" },
  "payments.fee": { "class": "money", "scope": "spine", "note": "gateway fee estimate at capture; payments.fee_minor" },
  "invoices.amount": { "class": "money", "scope": "spine", "note": "invoices.amount_minor" },
  "invoice_lines.unit_amount": { "class": "unit_price", "scope": "spine", "note": "invoice_lines.unit_amount_minor + currency" },
  "invoice_lines.amount": { "class": "money", "scope": "spine", "note": "invoice_lines.amount_minor" },
  "invoice_lines.tax": { "class": "money", "scope": "spine", "note": "invoice_lines.tax_minor" },
  "invoice_lines.qty": { "class": "quantity", "scope": "", "note": "" },
  "credit_notes.amount": { "class": "money", "scope": "spine", "note": "credit_notes.amount_minor" },
  "settlements.gross": { "class": "money", "scope": "spine", "note": "settlements.gross_minor + currency (added: settlements never recorded one)" },
  "settlements.commission": { "class": "money", "scope": "spine", "note": "settlements.commission_minor" },
  "settlements.net": { "class": "money", "scope": "spine", "note": "settlements.net_minor" },
  "disputes.amount": { "class": "money", "scope": "spine", "note": "disputes.amount_minor" },
  "payouts.gross": { "class": "money", "scope": "spine", "note": "payouts.gross_minor; payouts.currency now written" },
  "payouts.fee": { "class": "money", "scope": "spine", "note": "payouts.fee_minor" },
  "payouts.net": { "class": "money", "scope": "spine", "note": "payouts.net_minor" },
  "payout_items.amount": { "class": "money", "scope": "spine", "note": "payout_items.amount_minor" },
  "wallets.balance": { "class": "money", "scope": "projection", "note": "written only by lib/wallet.js from ledger_postings (INTEGER minor units)" },
  "wallet_entries.amount": { "class": "money", "scope": "projection", "note": "written only by lib/wallet.js from a posted journal" },
  "wallet_entries.balance_after": { "class": "money", "scope": "projection", "note": "written only by lib/wallet.js" },
  "currencies.usd": { "class": "exchange_rate", "scope": "input", "note": "the currency's value in the platform's reference unit; rates are read exactly" },
  "fx_rates.usd": { "class": "exchange_rate", "scope": "input", "note": "rate history" },
  "plans.price_month": { "class": "unit_price", "scope": "input", "note": "per month, in plans.currency; read exactly when invoiced" },
  "modules.price": { "class": "money", "scope": "input", "note": "read exactly (money.rounded) when a module is billed" },
  "products.price": { "class": "unit_price", "scope": "input", "note": "catalogue price in the store's base currency; read exactly, line = unit × qty rounded once" },
  "products.list_price": { "class": "unit_price", "scope": "input", "note": "" },
  "skus.price": { "class": "unit_price", "scope": "input", "note": "" },
  "skus.mrp": { "class": "unit_price", "scope": "input", "note": "" },
  "provider_defs.fee_fixed": { "class": "money", "scope": "input", "note": "a gateway's fixed fee, applied in the charge's currency (its own currency is not recorded — PR-045)" },
  "provider_defs.base_fee": { "class": "money", "scope": "input", "note": "a carrier's base fee in the store's base currency" },
  "provider_defs.fee_pct": { "class": "ratio", "scope": "", "note": "percent" },
  "tenant_state.gift_balance": { "class": "money", "scope": "domain", "note": "legacy session gift balance (the Universal Wallet holds balances)" },
  "usage_records.unit_amount": { "class": "unit_price", "scope": "input", "note": "metered rate; the invoice line is unit × qty rounded once" },
  "usage_records.amount": { "class": "money", "scope": "domain", "note": "metering estimate; the invoice recomputes the line exactly" },
  "usage_records.qty": { "class": "quantity", "scope": "", "note": "summed exactly (money.plus)" },
  "order_charge_rules.amount": { "class": "money", "scope": "input", "note": "a fee rule's fixed part; the charge line is rounded once in the bag's currency" },
  "order_charge_rules.below_amount": { "class": "money", "scope": "input", "note": "threshold" },
  "order_charge_rules.percent": { "class": "ratio", "scope": "", "note": "" },
  "bag_tips.amount": { "class": "money", "scope": "input", "note": "the tip line is rounded once in the bag's currency" },
  "media_sessions.rate": { "class": "unit_price", "scope": "domain", "note": "per-second price" },
  "trials.unit": { "class": "unit_price", "scope": "domain", "note": "" },
  "rides.surge": { "class": "ratio", "scope": "", "note": "multiplier" },
  "surge_zones.multiplier": { "class": "ratio", "scope": "", "note": "" },
  "loans.rate": { "class": "ratio", "scope": "", "note": "interest rate" },
  "seller_metrics.take_rate": { "class": "ratio", "scope": "", "note": "" },
  "seller_metrics.ad_roi": { "class": "ratio", "scope": "", "note": "" },
  "knowledge_graph.weight": { "class": "ratio", "scope": "", "note": "edge weight" },
  "sitemap_entries.priority": { "class": "ratio", "scope": "", "note": "" },
  "goip_settlements.redemptions": { "class": "quantity", "scope": "", "note": "count of redemptions" },
  "coupon_redemptions.credits": { "class": "quantity", "scope": "", "note": "loyalty credits, a non-money unit" },
  "goip_entitlements.qty": { "class": "quantity", "scope": "", "note": "" },
  "usage_events.quantity": { "class": "quantity", "scope": "", "note": "" },
  "rfqs.qty": { "class": "quantity", "scope": "", "note": "" },
  "exp_conversions.value": { "class": "measurement", "scope": "", "note": "experiment metric value" },
  "goip_touchpoints.value": { "class": "measurement", "scope": "", "note": "touchpoint metric" },
  "offers.value": { "class": "unit_price", "scope": "domain", "note": "a percent or an amount, by the offer's type" },
  "coupons.value": { "class": "unit_price", "scope": "domain", "note": "a percent or an amount, by the coupon's type" },
  "vouchers.value": { "class": "money", "scope": "domain", "note": "" },
  "commission_rules.commission_value": { "class": "unit_price", "scope": "domain", "note": "a percent or a fixed amount, by commission_type" },
  "replenishments.avg_daily": { "class": "quantity", "scope": "", "note": "units per day" },
  "replenishments.trend": { "class": "ratio", "scope": "", "note": "" }
 },
 "rules": [
  { "match": "\\.(lat|lng|pickup_lat|pickup_lng|dropoff_lat|dropoff_lng|center_lat|center_lng)$", "class": "measurement" },
  { "match": "\\.(service_radius_km|radius_km|distance_km|duration_min|eta_min|odometer|hours|estimate_hours|logged_hours|gross_weight|net_weight|package_weight|city_latency)$", "class": "measurement" },
  { "match": "\\.(rating|health_score|score|buybox_score)$", "class": "measurement" },
  { "match": "\\.(odr|late_ship_rate|cancel_rate|valid_tracked_rate|on_time_pct)$", "class": "ratio" },
  { "match": "_pct$", "class": "ratio" },
  { "match": "^tax_rules\\.(standard|reduced|digital|zero)$", "class": "ratio", "note": "tax rate, read exactly" },
  { "match": "\\.(price|unit_price|price_added|target_price|baseline_price|fired_price|start_price|reserve_price|buy_now_price|current_price|final_price|group_price|price_delta|est_unit_cost|unit_cost|original_unit|substitute_unit)$", "class": "unit_price", "scope": "domain" },
  { "match": "\\.(amount|fare|total|gross|net|fee|fees|commission|cost|revenue|spent|budget|bid_amount|balance|lifetime_sales|lifetime_commissions|min_payout|min_sales|min_order|max_order|min_amount|max_discount|delivery_fee|convenience_fee|credit_limit|used|available|principal|emi|processing_fee|premium|cover|max_amount|charged_amount|leader_max|charged|shortfall|deposit|refunded|refund|paid|earnings|base_salary|deductions|base|overtime|tax|taxable|tax_collected|total_value|counter_amount|ads_spend|allocated|reserved|consumed|redemptions)$", "class": "money", "scope": "domain" }
 ]
}
